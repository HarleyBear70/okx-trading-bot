// Jeff's Smoke Detector: a clean chart that only speaks up when something important is happening.
// Normal candles = nothing to do. Colored candles = look here:
//   WHITE / BLACK = pullback / loading: price is moving against the trend but the strong level still holds.
//   GREY = normal, nothing to do.
//   YELLOW = smoke, watch: close to a key high/low, squeezing sideways, a doji at a key level, or a minor break inside the trend.
//   ORANGE = trap: a wick swept a swing high/low but the BODY closed back inside, or a breakout failed within 3 candles.
//   BRIGHT GREEN / RED = BOS: a candle BODY closed beyond the last swing high/low, trend continues.
//   PURPLE = MARKET SHIFT: a candle BODY closed through the strong (protected) high/low, the trend flipped.
//   The MUST HOLD level follows each leg: when price breaks the last small low (downtrend), it moves to the lower high
//   that leg started from, so the first body close back above that leg high turns PURPLE (Oct 9 2026 fix).
// Lines: WHITE SOLID "MUST HOLD" = strong high/low. GREY DOTTED "TARGET" = weak high/low (liquidity).
// Auto drawing (redrawn after every BOS / market shift): the swing high + swing low of the move, the Fib 50% line with
// PREMIUM (top half) and DISCOUNT (bottom half) shaded, the latest supply zone in premium and demand zone in discount,
// and the latest few imbalances (FVG) that haven't been filled yet.
// Long/short box: only shows when price is in the right zone (discount in an uptrend = long, premium in a downtrend = short).
// Stop = just past the MUST HOLD level (small cushion so a wick into the liquidity doesn't stop you out).
// TP1 = just before the nearest liquidity (old high/low), TP2 = the -27% Fib extension. GOOD / SKIP = Jeff's % rules.
// Hover over the box labels for the full details. Read the daily first, then the 4H. Not a buy signal by itself.
// EARLY TURNS (Oct 8): BLUE "▲ early" / PINK "▼ early" = a small market shift (swings of 2 candles), the little turn
// you see before the big MUST HOLD level breaks. Candle pattern names (engulfing, hammer, stars, soldiers/crows,
// double top/bottom) only show away from the middle: buy patterns in the bottom 40% of the move, sell patterns in the top 40%.
// Early turns flip more often than the big shift: tested on 2019-now they're right about as often as wrong,
// so use them with your eyes, not on their own.
//@version=6
indicator("Jeff's Smoke Detector", shorttitle="Smoke", overlay=true, max_lines_count=40, max_labels_count=300, max_boxes_count=30)

swingLen  = input.int(5, "Swing size (candles on each side of a swing high/low)", minval=2, maxval=20)
nearAtr   = input.float(0.5, "'Getting close' distance (x ATR)", minval=0.1, step=0.1)
showLns   = input.bool(true, "Show the 2 key lines (solid = must hold, dotted = target)")
showBox   = input.bool(true, "Show the corner box")
showKey   = input.bool(true, "Show the color key")
showFib   = input.bool(true, "Show the auto Fib (premium / discount)")
showZones = input.bool(false, "Show the latest supply (premium) and demand (discount) zones")
showFvg   = input.bool(false, "Show the latest imbalances (FVG)")
fvgMax    = input.int(3, "How many imbalances to show", minval=1, maxval=6)
showPlan  = input.bool(true, "Show the long/short box when price is in the right zone")
slBuf     = input.float(0.15, "Stop cushion past the MUST HOLD level (x ATR)", minval=0, step=0.05)
acct      = input.float(197, "My account size ($)", minval=1)
riskPct   = input.float(0.5, "Risk per trade (% of account)", minval=0.05, maxval=5, step=0.05)
feePct    = input.float(0.35, "Fee per buy or sell (%)", minval=0, step=0.01)
ext1      = input.float(0.27, "TP2 Fib extension (0.27 = the -27% line)", minval=0.05, step=0.01)
maxSlPct  = input.float(1.35, "My rule: max stop loss (%)", minval=0.1, step=0.05)
minTpPct  = input.float(2.0, "My rule: min take profit (%)", minval=0.1, step=0.1)
showEarly = input.bool(false, "Show early turns (small market shifts)")
legLen    = input.int(1, "Market shift: leg swing size (candles each side)", minval=1, maxval=5)
miniLen   = input.int(2, "Early-turn swing size (candles each side)", minval=1, maxval=5)
showPat   = input.bool(false, "Show candle pattern names (only away from the middle)")

atr  = ta.atr(14)
ph   = ta.pivothigh(high, swingLen, swingLen)
pl   = ta.pivotlow(low, swingLen, swingLen)
lph  = ta.pivothigh(high, legLen, legLen)
lpl  = ta.pivotlow(low, legLen, legLen)
body = math.abs(close - open)
rng  = high - low

// Squeeze: Bollinger width near its lowest in 100 candles = price coiling sideways
basis   = ta.sma(close, 20)
bbw     = basis > 0 ? 4 * ta.stdev(close, 20) / basis : na
bbwLow  = ta.lowest(bbw, 100)
squeeze = not na(bbw) and not na(bbwLow) and bbw <= bbwLow * 1.10

var float swH    = na     // latest swing high
var float swL    = na     // latest swing low
var bool  hDone  = true   // latest swing high already broken?
var bool  lDone  = true
var int   trend  = 0      // 1 up, -1 down, 0 not known yet
var float strong = na     // protected level: a body close through it = market shift
var float ext    = na     // highest high of the up move / lowest low of the down move

// Supply / demand: the last up candle before a swing high (supply) / last down candle before a swing low (demand)
var float supTop = na
var float supBot = na
var int   supBar = na
var float demTop = na
var float demBot = na
var int   demBar = na

if not na(ph)
    swH   := ph
    hDone := false
    for i = swingLen to swingLen + 5
        if close[i] > open[i]
            supTop := math.max(high[i], ph)
            supBot := low[i]
            supBar := bar_index - i
            break
if not na(pl)
    swL   := pl
    lDone := false
    for i = swingLen to swingLen + 5
        if close[i] < open[i]
            demTop := high[i]
            demBot := math.min(low[i], pl)
            demBar := bar_index - i
            break
// a body close through a zone uses it up
if not na(supTop) and close > supTop
    supTop := na
    supBot := na
if not na(demBot) and close < demBot
    demTop := na
    demBot := na

// Imbalances (FVG): a gap between candle 1 and candle 3. Kept until price fills it.
var array<float> fTop = array.new<float>()
var array<float> fBot = array.new<float>()
var array<int>   fBar = array.new<int>()
var array<int>   fDir = array.new<int>()
if low > high[2] and (low - high[2]) >= 0.1 * atr
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fBar, bar_index - 1)
    array.push(fDir, 1)
if high < low[2] and (low[2] - high) >= 0.1 * atr
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fBar, bar_index - 1)
    array.push(fDir, -1)
if array.size(fTop) > 0
    for i = array.size(fTop) - 1 to 0
        filled = array.get(fDir, i) == 1 ? low <= array.get(fBot, i) : high >= array.get(fTop, i)
        if filled and array.get(fBar, i) < bar_index - 1
            array.remove(fTop, i)
            array.remove(fBot, i)
            array.remove(fBar, i)
            array.remove(fDir, i)
while array.size(fTop) > fvgMax
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fBar)
    array.shift(fDir)

// Leg structure (Jeff/Brad): each time the trend makes a new low by closing below the last small swing low,
// the MUST HOLD level moves down to the lower high that leg started from (and the mirror in an uptrend).
// A body close through that level = the true market shift.
var float legH  = na
var float legL  = na
var bool  legHd = true
var bool  legLd = true
if not na(lph)
    legH  := lph
    legHd := false
if not na(lpl)
    legL  := lpl
    legLd := false
if trend == -1 and not legLd and close < legL
    legLd := true
    if not na(legH) and not na(strong) and legH < strong
        strong := legH
if trend == 1 and not legHd and close > legH
    legHd := true
    if not na(legL) and not na(strong) and legL > strong
        strong := legL

bos      = false
shift    = false
trap     = false
internal = false

if trend == 1
    ext := math.max(nz(ext, high), high)
    if not na(strong) and close < strong
        shift  := true
        trend  := -1
        strong := ext
        ext    := low
        lDone  := true
        legLd  := true
    else if not hDone and close > swH
        bos    := true
        hDone  := true
        strong := na(strong) ? swL : math.max(strong, swL)
    else if not lDone and close < swL
        internal := true
        lDone    := true
else if trend == -1
    ext := math.min(nz(ext, low), low)
    if not na(strong) and close > strong
        shift  := true
        trend  := 1
        strong := ext
        ext    := high
        hDone  := true
        legHd  := true
    else if not lDone and close < swL
        bos    := true
        lDone  := true
        strong := na(strong) ? swH : math.min(strong, swH)
    else if not hDone and close > swH
        internal := true
        hDone    := true
else
    if not hDone and close > swH
        bos    := true
        trend  := 1
        hDone  := true
        strong := swL
        ext    := high
    else if not lDone and close < swL
        bos    := true
        trend  := -1
        lDone  := true
        strong := swH
        ext    := low

// Failed breakout (invalid BOS): within 3 candles of a BOS, a body closes back through the level it broke
var float bosLevel = na
var int   bosBar   = na
var int   bosDir   = 0
failedBos = false
if bos
    bosLevel := trend == 1 ? swH : swL
    bosBar   := bar_index
    bosDir   := trend
else if not na(bosLevel) and bar_index - bosBar <= 3 and not shift
    if (bosDir == 1 and close < bosLevel) or (bosDir == -1 and close > bosLevel)
        failedBos := true
        bosLevel  := na
if not na(bosBar) and bar_index - bosBar > 3
    bosLevel := na

// Target = the weak high (uptrend) or weak low (downtrend) not taken yet
weak = trend == 1 ? (hDone ? na : swH) : trend == -1 ? (lDone ? na : swL) : na

trapHigh = not na(swH) and not hDone and high > swH and close <= swH
trapLow  = not na(swL) and not lDone and low < swL and close >= swL
trap := ((trapHigh or trapLow) or failedBos) and not bos and not shift

nearWeak   = not na(weak) and math.abs(weak - close) <= nearAtr * atr
nearStrong = not na(strong) and math.abs(close - strong) <= nearAtr * atr
dojiLevel  = rng > 0 and body <= 0.1 * rng and (nearWeak or nearStrong)
smoke = nearWeak or nearStrong or squeeze or dojiLevel or internal

hi10 = ta.highest(close, 10)[1]
lo10 = ta.lowest(close, 10)[1]
expanding = trend == 1 ? close > hi10 : trend == -1 ? close < lo10 : false
pullback = trend != 0 and not expanding and not squeeze and not na(strong) and (trend == 1 ? close > strong : close < strong)

candleCol = shift ? color.rgb(170, 60, 255) : trap ? color.rgb(255, 140, 0) : bos ? (trend == 1 ? color.rgb(0, 230, 118) : color.rgb(255, 50, 50)) : smoke ? color.rgb(255, 214, 0) : pullback ? (close >= open ? color.white : color.black) : color.rgb(150, 150, 150)
barcolor(candleCol)

// ---------- Early turns: small market shifts on tiny swings, plus candle patterns ----------
mph = ta.pivothigh(high, miniLen, miniLen)
mpl = ta.pivotlow(low, miniLen, miniLen)
var float mH     = na
var float mL     = na
var int   mTrend = 0
earlyUp = false
earlyDn = false
dblBot  = false
dblTop  = false
if not na(mph)
    dblTop := not na(mH) and math.abs(mph - mH) <= 0.3 * atr
    mH     := mph
if not na(mpl)
    dblBot := not na(mL) and math.abs(mpl - mL) <= 0.3 * atr
    mL     := mpl
if mTrend != 1 and not na(mH) and close > mH and close > open
    earlyUp := mTrend == -1
    mTrend  := 1
else if mTrend != -1 and not na(mL) and close < mL and close < open
    earlyDn := mTrend == 1
    mTrend  := -1

hammer   = rng > 0 and body <= 0.35 * rng and math.min(open, close) - low >= 0.6 * rng
shooting = rng > 0 and body <= 0.35 * rng and high - math.max(open, close) >= 0.6 * rng
bullEng  = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
bearEng  = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]
mStar    = open[2] - close[2] > 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * (open[2] - close[2]) and close > open and close > (open[2] + close[2]) / 2
eStar    = close[2] - open[2] > 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * (close[2] - open[2]) and close < open and close < (open[2] + close[2]) / 2
solid(i) => math.abs(close[i] - open[i]) >= 0.5 * (high[i] - low[i])
soldiers = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and solid(0) and solid(1) and solid(2)
crows    = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and solid(0) and solid(1) and solid(2)

bullTxt = (hammer ? "Hammer " : "") + (bullEng ? "Engulfing " : "") + (mStar ? "Morning star " : "") + (soldiers ? "3 soldiers " : "") + (dblBot ? "Double bottom " : "")
bearTxt = (shooting ? "Shooting star " : "") + (bearEng ? "Engulfing " : "") + (eStar ? "Evening star " : "") + (crows ? "3 crows " : "") + (dblTop ? "Double top " : "")

// The move's range: MUST HOLD level to the furthest point of the move. 50% splits premium (top) / discount (bottom).
rangeOk = trend != 0 and not na(strong) and not na(ext) and strong != ext
rangeHi = rangeOk ? math.max(strong, ext) : na
rangeLo = rangeOk ? math.min(strong, ext) : na
mid     = rangeOk ? (rangeHi + rangeLo) / 2 : na
inDiscount = rangeOk and trend == 1 and close <= mid and close > strong
inPremium  = rangeOk and trend == -1 and close >= mid and close < strong

// where in the move are we? 0 = swing low, 1 = swing high. Middle (40-60%) = no pattern names.
pos     = rangeOk ? (close - rangeLo) / (rangeHi - rangeLo) : na
lowPart = na(pos) or pos <= 0.4
topPart = na(pos) or pos >= 0.6
upTxt = (showEarly and earlyUp ? "▲ early" : "") + (showPat and lowPart and bullTxt != "" ? ((showEarly and earlyUp) ? "\n" : "") + str.trim(bullTxt) : "")
dnTxt = (showEarly and earlyDn ? "▼ early" : "") + (showPat and topPart and bearTxt != "" ? ((showEarly and earlyDn) ? "\n" : "") + str.trim(bearTxt) : "")
if upTxt != ""
    label.new(bar_index, low, upTxt, style=label.style_label_up, color=earlyUp ? color.rgb(0, 190, 255) : color.rgb(0, 140, 80), textcolor=earlyUp ? color.black : color.white, size=size.normal)
if dnTxt != ""
    label.new(bar_index, high, dnTxt, style=label.style_label_down, color=earlyDn ? color.rgb(255, 120, 200) : color.rgb(170, 40, 40), textcolor=earlyDn ? color.black : color.white, size=size.normal)

// Long/short idea when price is in the right zone: entry = now, stop just past MUST HOLD, TP1 = liquidity, TP2 = -27% Fib
float pEntry = na
float pSL    = na
float pTP1   = na
float pTP2   = na
int   pDir   = 0
if showPlan and (inDiscount or inPremium)
    pDir   := inDiscount ? 1 : -1
    pEntry := close
    pSL    := pDir == 1 ? strong - slBuf * atr : strong + slBuf * atr
    hair   = 0.1 * atr
    minGap = math.max(0.5 * atr, close * 3 * feePct / 100)
    swingEnd = pDir == 1 ? rangeHi : rangeLo
    float liq = na
    if math.abs(swingEnd - close) >= minGap
        liq := swingEnd
    if not na(weak)
        aheadW = pDir == 1 ? weak > close + minGap : weak < close - minGap
        if aheadW and (na(liq) or math.abs(weak - close) < math.abs(liq - close))
            liq := weak
    fibX = swingEnd + pDir * ext1 * (rangeHi - rangeLo)
    pTP1 := na(liq) ? fibX - pDir * hair : liq - pDir * hair
    pTP2 := fibX - pDir * hair
    if math.abs(pTP2 - close) <= math.abs(pTP1 - close) + hair
        pTP2 := na

slPct   = pDir != 0 ? math.abs(pEntry - pSL) / pEntry * 100 : na
tp1Pct  = pDir != 0 ? math.abs(pTP1 - pEntry) / pEntry * 100 : na
tp2Pct  = pDir != 0 and not na(pTP2) ? math.abs(pTP2 - pEntry) / pEntry * 100 : na
rr1     = pDir != 0 ? math.abs(pTP1 - pEntry) / math.abs(pEntry - pSL) : na
goodNow = pDir != 0 and nz(slPct, 99) <= maxSlPct and (nz(tp1Pct) >= minTpPct or nz(tp2Pct) >= minTpPct)

// Position size so a stopped-out trade loses about riskPct of the account, fees included
riskUsd = acct * riskPct / 100
fee     = feePct / 100
posUsd  = pDir != 0 ? math.min(riskUsd / (slPct / 100 + 2 * fee), acct) : na
win1    = pDir != 0 ? posUsd * (tp1Pct / 100 - 2 * fee) : na
win2    = pDir != 0 and not na(pTP2) ? posUsd * (tp2Pct / 100 - 2 * fee) : na

// ---------- Drawing (last candle only, everything old is cleared first) ----------
var array<box>   bxs = array.new<box>()
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
clear = color.new(color.black, 100)
gCol  = color.rgb(0, 200, 100)
rCol  = color.rgb(230, 60, 60)
if barstate.islast
    for b in bxs
        box.delete(b)
    for ln in lns
        line.delete(ln)
    for lb in lbs
        label.delete(lb)
    array.clear(bxs)
    array.clear(lns)
    array.clear(lbs)
    xL = bar_index - 40
    xR = bar_index + 15
    if showLns and not na(strong)
        array.push(lns, line.new(bar_index - 30, strong, bar_index + 8, strong, extend=extend.right, color=color.rgb(235, 235, 235), width=2, style=line.style_solid))
        array.push(lbs, label.new(bar_index + 8, strong, "MUST HOLD " + str.tostring(strong, format.mintick), style=label.style_label_left, color=color.rgb(70, 70, 70), textcolor=color.white, size=size.normal))
    if showLns and not na(weak)
        array.push(lns, line.new(bar_index - 30, weak, bar_index + 8, weak, extend=extend.right, color=color.gray, width=1, style=line.style_dotted))
        array.push(lbs, label.new(bar_index + 8, weak, "TARGET " + str.tostring(weak, format.mintick), style=label.style_label_left, color=color.rgb(110, 110, 110), textcolor=color.white, size=size.normal))
    if showFib and rangeOk
        array.push(bxs, box.new(xL, rangeHi, xR, mid, border_color=clear, bgcolor=color.new(rCol, 92)))
        array.push(lbs, label.new(xL + 2, rangeHi - (rangeHi - mid) * 0.15, "PREMIUM", style=label.style_label_left, color=color.rgb(255, 175, 175), textcolor=color.black, size=size.normal))
        array.push(bxs, box.new(xL, mid, xR, rangeLo, border_color=clear, bgcolor=color.new(gCol, 92)))
        array.push(lbs, label.new(xL + 2, rangeLo + (mid - rangeLo) * 0.15, "DISCOUNT", style=label.style_label_left, color=color.rgb(170, 235, 190), textcolor=color.black, size=size.normal))
        array.push(lns, line.new(xL, mid, xR, mid, color=color.rgb(255, 214, 0), width=1, style=line.style_dashed))
        array.push(lbs, label.new(xL, mid, "50%  " + str.tostring(mid, format.mintick), style=label.style_label_right, color=color.rgb(255, 214, 0), textcolor=color.black, size=size.normal))
        array.push(lbs, label.new(xL, rangeHi, "Swing high  " + str.tostring(rangeHi, format.mintick), style=label.style_label_right, color=color.rgb(235, 235, 235), textcolor=color.black, size=size.normal))
        array.push(lbs, label.new(xL, rangeLo, "Swing low  " + str.tostring(rangeLo, format.mintick), style=label.style_label_right, color=color.rgb(235, 235, 235), textcolor=color.black, size=size.normal))
    if showZones and rangeOk
        if not na(demTop) and demTop <= mid
            array.push(bxs, box.new(demBar, demTop, xR, demBot, border_color=color.new(gCol, 60), bgcolor=color.new(gCol, 88), text="Demand", text_size=size.normal, text_color=color.white, text_halign=text.align_right))
        if not na(supBot) and supBot >= mid
            array.push(bxs, box.new(supBar, supTop, xR, supBot, border_color=color.new(rCol, 60), bgcolor=color.new(rCol, 88), text="Supply", text_size=size.normal, text_color=color.white, text_halign=text.align_right))
    if showFvg and array.size(fTop) > 0
        for i = 0 to array.size(fTop) - 1
            array.push(bxs, box.new(array.get(fBar, i), array.get(fTop, i), xR, array.get(fBot, i), border_color=color.new(color.rgb(170, 200, 255), 75), bgcolor=color.new(color.rgb(170, 200, 255), 93), text="Imbalance", text_size=size.normal, text_color=color.new(color.white, 35), text_halign=text.align_right))
    if pDir != 0
        x1 = bar_index + 1
        x2 = bar_index + 22
        tip = (pDir == 1 ? "LONG" : "SHORT") + " if you enter now" + "\nEntry: " + str.tostring(pEntry, format.mintick) + "\nStop: " + str.tostring(pSL, format.mintick) + "  (" + str.tostring(slPct, "#.##") + "%)" + "\nTP1: " + str.tostring(pTP1, format.mintick) + "  (" + str.tostring(tp1Pct, "#.##") + "%)" + (na(pTP2) ? "" : "\nTP2: " + str.tostring(pTP2, format.mintick) + "  (" + str.tostring(tp2Pct, "#.##") + "%)") + "\nReward/risk to TP1: " + str.tostring(rr1, "#.##") + "   after fees: " + str.tostring(win1 / riskUsd, "#.##") + (na(win2) ? "" : "\nReward/risk to TP2 after fees: " + str.tostring(win2 / riskUsd, "#.##")) + "\nBuy about $" + str.tostring(posUsd, "#.##") + "  (" + str.tostring(posUsd / pEntry, "#.######") + " coins)" + "\nIf stopped: lose about $" + str.tostring(riskUsd, "#.##") + "\nAt TP1: win about $" + str.tostring(win1, "#.##") + " after fees"
        array.push(bxs, box.new(x1, math.max(pEntry, pTP1), x2, math.min(pEntry, pTP1), border_color=gCol, bgcolor=color.new(gCol, 70)))
        array.push(bxs, box.new(x1, math.max(pEntry, pSL), x2, math.min(pEntry, pSL), border_color=rCol, bgcolor=color.new(rCol, 70)))
        array.push(lbs, label.new(x2, pEntry, (pDir == 1 ? "LONG  " : "SHORT  ") + (goodNow ? "GOOD" : "SKIP"), style=label.style_label_left, color=goodNow ? color.rgb(0, 150, 70) : color.rgb(200, 30, 30), textcolor=color.white, size=size.normal, tooltip=tip))
        array.push(lbs, label.new(x2, pSL, "SL " + str.tostring(slPct, "#.##") + "%", style=label.style_label_left, color=rCol, textcolor=color.white, size=size.normal, tooltip=tip))
        array.push(lbs, label.new(x2, pTP1, "TP1 " + str.tostring(tp1Pct, "#.##") + "%", style=label.style_label_left, color=gCol, textcolor=color.white, size=size.normal, tooltip=tip))
        if not na(pTP2)
            array.push(lns, line.new(x1, pTP2, x2, pTP2, color=color.rgb(0, 150, 70), width=2, style=line.style_dashed))
            array.push(lbs, label.new(x2, pTP2, "TP2 " + str.tostring(tp2Pct, "#.##") + "%", style=label.style_label_left, color=color.rgb(0, 150, 70), textcolor=color.white, size=size.normal, tooltip=tip))

plotshape(bos or shift ? trend == 1 : false, "Long", shape.triangleup, location.belowbar, color.rgb(0, 200, 100), size=size.small)
plotshape(bos or shift ? trend == -1 : false, "Short", shape.triangledown, location.abovebar, color.rgb(230, 60, 60), size=size.small)

// Corner box
lvl   = str.tostring(strong, format.mintick)
phase = squeeze ? "Sideways: squeeze, breakout coming" : expanding ? "Expanding" : pullback ? "Pullback, loading orders: holds while " + (trend == 1 ? "above " : "below ") + lvl : trend != 0 ? "Testing the strong level " + lvl : "Waiting for structure"
who   = trend == 1 ? "UP: buyers in control" : trend == -1 ? "DOWN: sellers in control" : "No clear trend yet"
var table tb = table.new(position.top_right, 1, 6, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=1, border_width=3)
if barstate.islast and showBox
    table.cell(tb, 0, 0, who, text_color=trend == 1 ? color.rgb(0, 230, 118) : trend == -1 ? color.rgb(255, 80, 80) : color.white, text_size=size.normal)
    table.cell(tb, 0, 1, phase, text_color=color.white, text_size=size.normal)
    if pDir != 0
        planTxt = (pDir == 1 ? "LONG idea (enter now): " : "SHORT idea (enter now): ") + "SL " + str.tostring(pSL, format.mintick) + "   TP1 " + str.tostring(pTP1, format.mintick) + (na(pTP2) ? "" : "   TP2 " + str.tostring(pTP2, format.mintick))
        table.cell(tb, 0, 2, planTxt, text_color=pDir == 1 ? color.rgb(0, 230, 118) : color.rgb(255, 80, 80), text_size=size.normal)
        sizeTxt = "Risk $" + str.tostring(riskUsd, "#.##") + " -> buy $" + str.tostring(posUsd, "#.##") + " (" + str.tostring(posUsd / pEntry, "#.######") + " coins). Win at TP1 ~$" + str.tostring(win1, "#.##") + (na(win2) ? "" : ", at TP2 ~$" + str.tostring(win2, "#.##"))
        table.cell(tb, 0, 3, sizeTxt, text_color=color.white, text_size=size.normal)
        checkTxt = (goodNow ? "GOOD TRADE" : "SKIP") + "   SL " + str.tostring(slPct, "#.##") + "%   TP1 " + str.tostring(tp1Pct, "#.##") + "%" + (na(tp2Pct) ? "" : "   TP2 " + str.tostring(tp2Pct, "#.##") + "%") + "   |   after fees R:R " + str.tostring(win1 / riskUsd, "#.#") + (na(win2) ? "" : " / " + str.tostring(win2 / riskUsd, "#.#"))
        table.cell(tb, 0, 4, checkTxt, text_color=color.white, bgcolor=goodNow ? color.rgb(0, 150, 70) : color.rgb(200, 30, 30), text_size=size.large)
    else
        waitTxt = not rangeOk ? "No trade idea: waiting for structure" : inDiscount ? "IN DISCOUNT now (below " + str.tostring(mid, format.mintick) + "): long zone. Turn on the long/short box in settings to see SL/TP" : inPremium ? "IN PREMIUM now (above " + str.tostring(mid, format.mintick) + "): short zone. Turn on the long/short box in settings to see SL/TP" : trend == 1 ? "No trade now: wait for a pullback into DISCOUNT (below " + str.tostring(mid, format.mintick) + ")" : "No trade now: wait for a bounce into PREMIUM (above " + str.tostring(mid, format.mintick) + ")"
        table.cell(tb, 0, 2, waitTxt, text_color=color.rgb(200, 200, 200), text_size=size.normal)
        table.cell(tb, 0, 3, "", text_size=size.normal)
        table.cell(tb, 0, 4, "", text_size=size.normal, bgcolor=clear)
    if showEarly and mTrend != 0
        table.cell(tb, 0, 5, "Early turn: " + (mTrend == 1 ? "▲ UP (small shift up)" : "▼ DOWN (small shift down)"), text_color=color.black, bgcolor=mTrend == 1 ? color.rgb(0, 190, 255) : color.rgb(255, 120, 200), text_size=size.normal)

// Phone / app alerts (TradingView: Alert > Condition: Jeff's Smoke Detector)
alertcondition(goodNow and not goodNow[1], "GOOD TRADE setup", "Smoke Detector: a GOOD TRADE setup is on the chart (stop and target inside my rules)")
alertcondition(shift, "PURPLE: market shift", "Market shift: a body closed through the strong high/low")
alertcondition(trap, "ORANGE: trap", "Trap: a wick swept a swing high/low and closed back inside, or a breakout failed")
alertcondition(bos, "BOS", "Break of structure: trend continues")
alertcondition(earlyUp, "EARLY TURN UP", "Early turn up: a small market shift up (swings of 2 candles)")
alertcondition(earlyDn, "EARLY TURN DOWN", "Early turn down: a small market shift down (swings of 2 candles)")
alertcondition(smoke and not (shift or trap or bos), "YELLOW: smoke", "Watch: near a key level, squeezing, or a doji at a level")

// Color key: big, easy-to-read box in the lower-left corner
var table keyTb = table.new(position.bottom_left, 2, 10, bgcolor=color.rgb(55, 55, 55), frame_color=color.gray, frame_width=1, border_width=1)
keyRow(r, c, t) =>
    table.cell(keyTb, 0, r, "    ", bgcolor=c, text_size=size.normal)
    table.cell(keyTb, 1, r, t, text_color=color.white, text_size=size.normal, text_halign=text.align_left)
if barstate.islast and showKey
    keyRow(0, color.white, "Buyers pushing (pullback)")
    keyRow(1, color.black, "Sellers pushing (pullback)")
    keyRow(2, color.rgb(255, 214, 0), "Watch - move coming")
    keyRow(3, color.rgb(255, 140, 0), "Fake-out - do nothing")
    keyRow(4, color.rgb(0, 230, 118), "BOS up - stays bullish")
    keyRow(5, color.rgb(255, 50, 50), "BOS down - stays bearish")
    keyRow(6, color.rgb(170, 60, 255), "Market shift - flipping")
    keyRow(7, color.rgb(150, 150, 150), "Grey = normal, nothing to do")
    keyRow(8, color.rgb(0, 190, 255), "▲ early = small turn up")
    keyRow(9, color.rgb(255, 120, 200), "▼ early = small turn down")
