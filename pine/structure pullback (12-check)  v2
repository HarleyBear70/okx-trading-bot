//@version=5
// SP-12 v2 — same 12 checks as SP-12, plus a "Tuned" scoring mode and wider stops,
// based on a backtest of BTC/ETH/SOL/XAUT 4H (Jun 2024 - Oct 2026).
// Tuned mode: +1 for checks that helped, -1 for checks that hurt, 0 for neutral ones.
strategy("Structure Pullback (12-Check) v2", shorttitle="SP-12 v2", overlay=true,
     initial_capital=1000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.1,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
     max_labels_count=300, max_lines_count=300)

// ───────── Settings ─────────
grpS = "Signal"
scoring    = input.string("Tuned", "Scoring", options=["Tuned", "Original"], group=grpS)
minScore   = input.int(7, "Original: minimum checks to enter", minval=3, maxval=12, group=grpS)
minTuned   = input.int(2, "Tuned: minimum net score", minval=-4, maxval=4, group=grpS)
pivotLen   = input.int(5, "Swing strength (candles each side)", minval=2, maxval=15, group=grpS)
momentum   = input.bool(false, "Original: momentum mode (don't count discount + sweep)", group=grpS)
reqRsiBos  = input.bool(false, "Require RSI healthy + recent BOS", group=grpS)
grpR = "Risk"
riskPct    = input.float(1.0, "Risk per trade (% of account)", minval=0.1, maxval=5, step=0.1, group=grpR)
maxRisk    = input.float(4.0, "Max stop-loss distance %", minval=0.3, maxval=10, step=0.1, group=grpR)
minRisk    = input.float(1.5, "Min stop-loss distance %", minval=0.1, maxval=5, step=0.1, group=grpR)
rr         = input.float(2.5, "Reward : risk", minval=1, maxval=6, step=0.5, group=grpR)
tpMin      = input.float(3.0, "Take profit at least %", minval=0.5, maxval=20, step=0.1, group=grpR)
tpMax      = input.float(10.0, "Take profit at most %", minval=0.5, maxval=30, step=0.1, group=grpR)
maxBars    = input.int(60, "Close trade after N candles", minval=5, maxval=500, group=grpR)
grpV = "Display"
showMarks  = input.bool(true, "Show BOS / sweep / FVG marks", group=grpV)
showScore  = input.bool(true, "Show score on signals", group=grpV)

// ───────── Higher timeframes (completed candles only, no repaint) ─────────
supertrendDir() =>
    [_st, _d] = ta.supertrend(3, 10)
    _d[1]

dClose  = request.security(syminfo.tickerid, "D",   close[1], lookahead=barmerge.lookahead_on)
dEma    = request.security(syminfo.tickerid, "D",   ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
dEmaP   = request.security(syminfo.tickerid, "D",   ta.ema(close, 20)[2], lookahead=barmerge.lookahead_on)
h4Close = request.security(syminfo.tickerid, "240", close[1], lookahead=barmerge.lookahead_on)
h4Ema   = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
h4Dir   = request.security(syminfo.tickerid, "240", supertrendDir(), lookahead=barmerge.lookahead_on)

dailyUp = dClose > dEma and dEma > dEmaP
h4Up    = h4Close > h4Ema and h4Dir < 0

// ───────── Entry-timeframe structure ─────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

var int   bosBar   = na
var int   sweepBar = na
var float obTop    = na
var float obBot    = na
var int   obBar    = na
var float fvgTop   = na
var float fvgBot   = na
var int   fvgBar   = na

bosUp = not na(lastPH) and close > lastPH and close[1] <= lastPH
if bosUp
    bosBar := bar_index
    obTop := na
    obBot := na
    for k = 1 to 10
        if close[k] < open[k]
            obTop := high[k]
            obBot := low[k]
            obBar := bar_index
            break

newFvg = low > high[2]
if newFvg
    fvgTop := low
    fvgBot := high[2]
    fvgBar := bar_index

swept = not na(lastPL) and low < lastPL and close > lastPL
if swept
    sweepBar := bar_index

// ───────── The 12 checks ─────────
rangeHigh = ta.highest(high, 30)
rangeLow  = ta.lowest(low, 30)
eq        = (rangeHigh + rangeLow) / 2

r = ta.rsi(close, 14)
[stLine, stDir] = ta.supertrend(3, 10)
[macdLine, sigLine, hist] = ta.macd(close, 12, 26, 9)
volAvg = ta.sma(volume, 20)

body   = math.abs(close - open)
lowerW = math.min(close, open) - low
upperW = high - math.max(close, open)
engulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
hammer = body > 0 and lowerW >= 2 * body and upperW <= body

c1  = dailyUp
c2  = h4Up
c3  = not na(bosBar) and bar_index - bosBar <= 20
c4  = close <= eq
c5  = not na(fvgBar) and bar_index > fvgBar and bar_index - fvgBar <= 30 and low <= fvgTop and close >= fvgBot
c6  = not na(obBar) and bar_index > obBar and bar_index - obBar <= 30 and low <= obTop and close >= obBot
c7  = not na(sweepBar) and bar_index - sweepBar <= 10
c8  = r > 40 and r < 65 and r > r[1]
c9  = volume > volAvg
c10 = engulf or hammer
c11 = stDir < 0
c12 = hist > hist[1]

b(x) => x ? 1 : 0
scoreOrig = b(c1) + b(c2) + b(c3) + (c4 and not momentum ? 1 : 0) + b(c5) + b(c6) +
     (c7 and not momentum ? 1 : 0) + b(c8) + b(c9) + b(c10) + b(c11) + b(c12)
// Tuned: helped = daily trend, sweep, supertrend, MACD rising; hurt = recent BOS, FVG tap, OB tap, bull candle
scoreTuned = b(c1) + b(c7) + b(c11) + b(c12) - b(c3) - b(c5) - b(c6) - b(c10)
tuned = scoring == "Tuned"
score = tuned ? scoreTuned : scoreOrig
scoreOk = tuned ? scoreTuned >= minTuned : scoreOrig >= minScore
reqOk = not reqRsiBos or (c3 and c8)

// ───────── Stops, targets, size ─────────
swingStop = ta.lowest(low, 10) * (1 - 0.001)
rawRisk   = (close - swingStop) / close * 100
riskUse   = math.max(rawRisk, minRisk)
tpPct     = math.min(math.max(rr * riskUse, tpMin), tpMax)

longSignal = c2 and reqOk and scoreOk and rawRisk <= maxRisk and strategy.position_size == 0 and barstate.isconfirmed

var float slPrice  = na
var float tpPrice  = na
var int   entryBar = na

if longSignal
    slPrice  := close * (1 - riskUse / 100)
    tpPrice  := close * (1 + tpPct / 100)
    entryBar := bar_index
    riskCash = strategy.equity * riskPct / 100
    qty      = math.min(riskCash / (close - slPrice), strategy.equity / close)
    msg = '{"action":"buy","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close) +
         ',"sl":' + str.tostring(slPrice) + ',"tp":' + str.tostring(tpPrice) + ',"score":' + str.tostring(score) + '}'
    strategy.entry("Long", strategy.long, qty=qty, alert_message=msg)
    if showScore
        label.new(bar_index, low, "BUY " + (tuned ? "net " + str.tostring(score) : str.tostring(score) + "/12") + "\nSL " + str.tostring(riskUse, "#.##") + "%  TP " + str.tostring(tpPct, "#.##") + "%",
             style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.small)

if strategy.position_size > 0
    strategy.exit("Exit", "Long", stop=slPrice, limit=tpPrice,
         alert_message='{"action":"sell","ticker":"' + syminfo.ticker + '"}')
    if not na(entryBar) and bar_index - entryBar >= maxBars
        strategy.close("Long", comment="Time exit", alert_message='{"action":"sell","ticker":"' + syminfo.ticker + '","reason":"time"}')

// ───────── Chart marks ─────────
plot(strategy.position_size > 0 ? slPrice : na, "Stop-loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? tpPrice : na, "Take profit", color=color.green, style=plot.style_linebr, linewidth=2)
plot(eq, "50% line (premium above / discount below)", color=color.new(color.gray, 40), style=plot.style_circles, linewidth=1)
plot(stLine, "Supertrend", color=stDir < 0 ? color.new(color.teal, 0) : color.new(color.maroon, 0), linewidth=1)
plotshape(showMarks and bosUp,  "BOS up",   shape.labelup,   location.belowbar, color.new(color.blue, 20),   text="BOS", textcolor=color.white, size=size.tiny)
plotshape(showMarks and swept,  "Sweep",    shape.triangleup, location.belowbar, color.new(color.orange, 0), text="sweep", textcolor=color.orange, size=size.tiny)
plotshape(showMarks and newFvg, "Bull FVG", shape.square,     location.belowbar, color.new(color.purple, 40), size=size.tiny)
bgcolor(h4Up ? color.new(color.green, 94) : color.new(color.red, 96), title="4H trend")

// Dashboard: third column shows how each check counts in Tuned mode (+1 / -1 / 0)
var table t = table.new(position.top_right, 3, 14, border_width=1)
if barstate.islast
    names = array.from("Daily trend up", "4H trend up*", "Recent BOS", "In discount", "Tapped FVG", "Tapped order block", "Liquidity sweep", "RSI healthy", "Volume > avg", "Bull candle", "Supertrend up", "MACD rising")
    vals  = array.from(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12)
    wts   = array.from("+1", "req", "-1", "0", "-1", "-1", "+1", "0", "0", "-1", "+1", "+1")
    table.cell(t, 0, 0, "Check", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 1, 0, tuned ? "net " + str.tostring(score) : str.tostring(score) + "/12", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 2, 0, "Tuned", text_color=color.white, bgcolor=color.new(color.gray, 20))
    for i = 0 to 11
        ok = array.get(vals, i)
        table.cell(t, 0, i + 1, array.get(names, i), text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)
        table.cell(t, 1, i + 1, ok ? "✔" : "✘", text_color=ok ? color.lime : color.red, bgcolor=color.new(color.black, 30), text_size=size.small)
        table.cell(t, 2, i + 1, array.get(wts, i), text_color=color.gray, bgcolor=color.new(color.black, 30), text_size=size.small)

if longSignal
    alert("SP-12 v2 buy signal on " + syminfo.ticker + " at " + str.tostring(close) + " (score " + str.tostring(score) + ")", alert.freq_once_per_bar_close)
