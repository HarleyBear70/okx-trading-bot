// Jeff's Structure (Tier 1 + Tier 2 supply/demand zones) - Oct 14 2026. Replaces T2a order blocks (pine/structure_t2a.pine). Issues #6-#9, Chrome Claude + Jeff. Tier 1 = pine/structure_t1.pine.
// No trade box, no patterns, no early turns. Same logic as research/struct_t1.py + struct_sd.py, which were checked against
// Jeff's marks (BTC 1H Oct 12-13, ETH 1H Oct 12-13, SOL 1H Oct 8-9 iBOS) and prints every event for a week.
//   All breaks are candle BODY closes. A wick alone never counts. No "N candles each side" swing points.
//   UP trend: WEAK = the high to beat. STRONG = the low that launched the last BOS up (fib 100%, protected).
//     BOS up (GREEN)  a body closes above WEAK after a pullback. STRONG = the lowest low between the old WEAK and the
//                     break (the pullback low that launched it); WEAK = the newest high. No next-candle hold (Jeff, "A").
//     MS (PURPLE)     a body closes below STRONG and the next candle also closes below: the trend flips.
//                     The top of the run becomes the new STRONG. (Undone by the next candle = ORANGE.)
//     MS? (LIGHT PURPLE) the 1st body close past STRONG, shown right away as a heads-up (Jeff, Oct 15). The next candle
//                     turns it solid PURPLE (held = MS) or ORANGE (undone). Test: 1st close vs hold = same PF (research/MS_HOLD_TEST.md).
//     SWEEP (ORANGE)  a wick past WEAK or STRONG with no body close past it. A wick never moves WEAK or STRONG.
//                     Also a wick past a KEY pullback low and close back: a pullback low counts as key once price
//                     makes a new high after it (Jeff OK, Oct 13: BTC Oct 12 4 PM swept the 10 AM high).
//   DOWN trend = mirror (BOS down = RED).
//   INTERNAL break (TEAL = buyers, BROWN = sellers): a body closes above the HIGH of the candle just before the low
//     (the candle the last drop started from); bearish = mirror. Does not flip the trend.
//   PULLBACK: WHITE = green candle / BLACK = red candle, while price is pulling back (no new high/low yet).
//   WATCH (YELLOW): close within 0.5 x ATR of STRONG or WEAK (same setting as Smoke Detector v22).
//   Top-right box: the 4H trend (same rules on 4H candles, last closed 4H candle) next to this chart's trend.
//   TIER 2 SUPPLY / DEMAND ZONES (Jeff, Oct 14, #9; his SOL 15m Oct 13 drawing A 4:00 AM, B 10:15 AM, C 3 PM, D 11:30 PM):
//     ONE candle, wick to wick. Supply A = where the current bearish move started (nothing older, a body close above A
//     ends it): from the top candle of the run, the last GREEN candle before the first body close below that candle's low.
//     Then every later top = a green candle followed by a red candle (a place to pull back to for fuel). Removed ONLY when
//     a body closes past its far edge (a wick = sweep, stays). Demand = mirror. Shown: supply whose
//     50% is in premium, demand whose 50% is in discount, both sides. A stands alone; "same area" boxes merge into one box,
//     one letter (Jeff: demand Oct 13 = A | 7:45+8:30+9:00 | 9:45+7PM+7:45PM; supply = A | B). See-through fill.
//     [Claude's fill-ins: the A wording above; letters by the box's 50%; a box joins a group when its 50% is inside the
//     group's first box (no number); a tie = the bigger box first (Chrome).]
//   TIER 2b LIQUIDITY $$$ (Jeff, Oct 14, #9): the money (stops) sits above wicks and below wicks. Once a wick takes it,
//     it is gone ("the fuel station is empty"). D $$$ = yesterday's daily candle high and low (TradingView's day; on SOL
//     Oct 14 = Jeff's D SH 109.07 / D SL 101.63). $$$ = equal highs: a top (green candle then red candle; its wick = the
//     higher of the two) whose upper wick a later top's high reaches into (between its body top and its high), with no
//     wick past it in between; the line sits on the highest high. Equal lows = mirror. Only since the start of the current
//     fib leg; a level inside another level's wick is dropped (one line per group). Leg $$$ = the highest high since the
//     break before the latest break (uptrend: lowest low), shown when it is past STRONG: the stops for the whole leg
//     (Jeff Oct 14: his "yellow candle" 113.33 on SOL 1H). [Claude's rules, no number]
//   CHECKLIST (Jeff Oct 15: "tell me WAIT or READY"). Rule 13 Way A (rules/JEFF_RULES_from_Brad.txt) + rules 7, 7b/38, 11b,
//     12, 16, 29. Each side (LONG / SHORT) on its own, both ways (rule 1b). Steps, in order, on CLOSED candles only:
//     1 ZONE: the sweep was in discount (long) / premium (short), or the shift was a TRUE MS (solid purple, rule 7b/38).
//     2 SWEEP: a wick past a recent low ($$$ bottom, yesterday's low, STRONG/WEAK) and the body closes back (rule 8/12).
//     3 MS: after the sweep, the 15m shifts my way: internal up (teal), BOS up, or a true MS up (rule 13c).
//     4 PULLBACK: price comes back into the zone that made the shift (rule 13d).
//     5 CONFIRM: a candle closes my way past the last candle's high (low) (rule 13e) -> READY, if R:R >= 1.5.
//     Stop = the sweep low (rule 29). Target = the nearest untouched level my way ($$$, D $$$, WEAK/STRONG) (rule 34).
//     Off: a body close past the sweep low or an MS against (rules 12/16), target hit first (rule 12), one try (rule 16).
//     [Claude's fill-ins: "small MS" = the board's internal / BOS / MS; "zone that made the shift" = the last red candle
//     (short: green) between the sweep and the shift, its high (low); "strong candle" = closes past the last candle's
//     high (low); stop exactly at the sweep wick (rule 29's "a little beyond" gap is not set); a deeper sweep restarts.]
//   [Claude's fill-ins: "pullback" = at least 1 candle that did not make a new high/low; equal lows = within 0.01%.]
//@version=6
indicator("Jeff's Structure Zones TEST", shorttitle="Structure TEST", overlay=true, max_lines_count=100, max_labels_count=100, max_boxes_count=100, max_bars_back=2000)

iCol     = input.color(color.rgb(0, 200, 200), "Internal break up (buyers)")
iColDn   = input.color(color.rgb(140, 85, 40), "Internal break down (sellers)")
nearAtr  = input.float(0.5, "Watch: 'getting close' distance (x ATR)", minval=0.1, step=0.1)
showFib  = input.bool(true, "Show premium / discount (fib STRONG to WEAK)")
showLns  = input.bool(true, "Show the STRONG / WEAK lines")
showBox  = input.bool(true, "Show the corner box")
showOB   = input.bool(true, "Show supply / demand zones (A, B, C...)")
midCol   = input.color(color.rgb(255, 0, 200), "50% line color")
showLiq  = input.bool(true, "Show liquidity $$$ (yesterday's high/low + equal highs/lows)")
liqCol   = input.color(color.rgb(0, 170, 70), "$$$ color")
liqOld   = input.bool(true, "$$$: also show OLDER untouched equal highs/lows (last 1500 candles)")
obTrend  = input.bool(false, "Zones only WITH the trend (supply in a downtrend, demand in an uptrend)")
showChk  = input.bool(true, "Show the READY / WAIT checklist")
minRR    = input.float(1.5, "Checklist: minimum reward-to-risk (rule 11b)", minval=0.5, step=0.1)

GREEN  = color.rgb(0, 230, 118)
RED    = color.rgb(255, 50, 50)
PURPLE = color.rgb(170, 60, 255)
LPURPLE = color.rgb(150, 120, 255)
ORANGE = color.rgb(255, 140, 0)
YELLOW = color.rgb(255, 214, 0)
TOL    = 0.0001

// lowest low / highest high from bar a to e bars ago (e = 0: up to this bar), and where. na if the range is empty.
f_lo(a, e) =>
    n = math.min(bar_index - a, 1500)
    m = float(na)
    at = int(na)
    if n >= e
        for i = e to n
            if na(m) or low[i] < m
                m := low[i]
                at := bar_index - i
    [m, at]
f_hi(a, e) =>
    n = math.min(bar_index - a, 1500)
    m = float(na)
    at = int(na)
    if n >= e
        for i = e to n
            if na(m) or high[i] > m
                m := high[i]
                at := bar_index - i
    [m, at]

// the whole structure engine (a function, so the same rules can also run on 4H candles)
f_engine() =>
    var int   trend   = 0
    var float strong  = na
    var int   sb      = na
    var float weak    = na
    var int   wb      = na
    var bool  pulled  = false
    var int   pendBar = na      // MS waiting for the next candle
    var float pendLvl = na
    var float key     = na      // key pullback low (up) / high (down)
    var float hiAll   = na
    var float loAll   = na
    var int   ilo = na
    var float iloL = na
    var float iloRef = na
    var int   iloFrom = 0
    var int   ihi = na
    var float ihiH = na
    var float ihiRef = na
    var int   ihiFrom = 0
    w0 = nz(wb, bar_index)
    [lo1, lo1b] = f_lo(w0, 1)       // WEAK candle .. last candle
    [hi1, hi1b] = f_hi(w0, 1)
    [lo0, lo0b] = f_lo(w0 + 1, 0)   // after the WEAK candle .. this candle
    [hi0, hi0b] = f_hi(w0 + 1, 0)
    evPrev = 0   // last candle: 3 MS up, 4 MS down, 5 sweep (MS undone)
    evCur  = 0   // this candle: 1 BOS up, 2 BOS down, 5 sweep, 6 internal up, 7 internal down
    if trend == 0
        if bar_index > 0 and close > hiAll
            trend := 1
            strong := loAll
            weak := high
            wb := bar_index
        else if bar_index > 0 and close < loAll
            trend := -1
            strong := hiAll
            weak := low
            wb := bar_index
        hiAll := na(hiAll) ? high : math.max(hiAll, high)
        loAll := na(loAll) ? low : math.min(loAll, low)
    else
        up = trend == 1
        if not na(pendBar)
            b = pendBar
            if up ? close < pendLvl : close > pendLvl
                trend := -trend
                up := not up
                strong := up ? lo1 : hi1      // the top (bottom) of the run
                sb := up ? lo1b : hi1b
                weak := up ? high[1] : low[1]
                wb := b
                pulled := false
                key := na
                if up
                    ilo := na
                    iloFrom := b
                else
                    ihi := na
                    ihiFrom := b
                evPrev := up ? 3 : 4
            else
                evPrev := 5
            pendBar := na
        msNow = up ? close < strong : close > strong
        if msNow
            pendBar := bar_index
            pendLvl := strong
        else
            if up ? low < strong : high > strong
                evCur := 5
            if not na(key)
                if up ? low < key : high > key
                    if up ? close >= key : close <= key
                        evCur := 5
                    key := na
            if up ? high > weak : low < weak
                if pulled
                    if up ? close > weak : close < weak
                        strong := up ? lo0 : hi0
                        sb := up ? lo0b : hi0b
                        weak := up ? hi0 : lo0
                        wb := up ? hi0b : lo0b
                        pulled := wb != bar_index
                        key := na
                        if up
                            ilo := na
                            iloFrom := bar_index
                        else
                            ihi := na
                            ihiFrom := bar_index
                        evCur := up ? 1 : 2
                    else
                        evCur := 5
                        key := up ? lo1 : hi1
                else
                    weak := up ? high : low
                    wb := bar_index
            else if wb != bar_index
                pulled := true
            // internal breaks (skipped on a candle waiting to be an MS)
            if bar_index > iloFrom and (na(ilo) or low < iloL * (1 - TOL)) and low < low[1]
                ilo := bar_index
                iloL := low
                iloRef := high[1]
            if bar_index > ihiFrom and (na(ihi) or high > ihiH * (1 + TOL)) and high > high[1]
                ihi := bar_index
                ihiH := high
                ihiRef := low[1]
            iEv = 0
            if not na(ilo) and bar_index > ilo and close > iloRef
                iEv := 6
                ilo := na
                iloFrom := bar_index
            else if not na(ihi) and bar_index > ihi and close < ihiRef
                iEv := 7
                ihi := na
                ihiFrom := bar_index
            if evCur == 0
                evCur := iEv
    [trend, strong, sb, weak, wb, pulled, pendBar, evPrev, evCur]

[trend, strong, sb, weak, wb, pulled, pendBar, evPrev, evCur] = f_engine()

f_t4() =>
    [t, s, a, w, b, p, q, e1, e2] = f_engine()
    t[1]
t4 = request.security(syminfo.tickerid, "240", f_t4(), lookahead=barmerge.lookahead_on)

// TIER 2: supply / demand zones
var array<float> zTop  = array.new_float()
var array<float> zBot  = array.new_float()
var array<int>   zSide = array.new_int()   // 1 = demand (buy), -1 = supply (sell)
var array<int>   zOb   = array.new_int()   // the zone's candle
var int supA = na
var int demA = na
f_clear(sd) =>
    if array.size(zSide) > 0
        for i = array.size(zSide) - 1 to 0
            if array.get(zSide, i) == sd
                array.remove(zTop, i)
                array.remove(zBot, i)
                array.remove(zSide, i)
                array.remove(zOb, i)
    true
f_add(sd, off) =>
    array.push(zTop, high[off])
    array.push(zBot, low[off])
    array.push(zSide, sd)
    array.push(zOb, bar_index - off)
    if array.size(zTop) > 200
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zSide)
        array.shift(zOb)
    true
// A: on an MS (reported on the last candle). From the top candle of the run (the new STRONG candle), the last green (red)
// candle before the first body close below the top candle's low (above its high). If none, the last one before the top candle.
if (evPrev == 3 or evPrev == 4) and not na(sb) and bar_index - sb <= 1500
    sd = evPrev == 3 ? 1 : -1
    b = bar_index - 1
    offT = bar_index - sb
    hT = high[offT]
    lT = low[offT]
    stp = b + 1
    if sb + 1 <= b
        for x = sb + 1 to b
            ox = bar_index - x
            if sd == 1 ? close[ox] > hT : close[ox] < lT
                stp := x
                break
    off = int(na)
    for x = sb to stp - 1
        ox = bar_index - x
        if sd == 1 ? close[ox] < open[ox] : close[ox] > open[ox]
            off := ox
    if na(off)
        for i = offT + 1 to math.min(bar_index, 1500)
            if sd == 1 ? close[i] < open[i] : close[i] > open[i]
                off := i
                break
    if not na(off)
        f_clear(sd)
        f_add(sd, off)
        if sd == 1
            demA := bar_index - off
        else
            supA := bar_index - off
// B, C ...: a green candle then a red candle (supply) / a red candle then a green candle (demand), after A
if not na(supA) and bar_index - 1 > supA and close[1] > open[1] and close < open
    f_add(-1, 1)
if not na(demA) and bar_index - 1 > demA and close[1] < open[1] and close > open
    f_add(1, 1)
// removed only on a body close past the far edge
if array.size(zTop) > 0
    for i = array.size(zTop) - 1 to 0
        if array.get(zSide, i) == 1 ? close < array.get(zBot, i) : close > array.get(zTop, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zSide, i)
            array.remove(zOb, i)

// colors: only after the candle closes
atr = ta.atr(14)
waiting = not na(pendBar) and pendBar == bar_index
nearLvl = trend != 0 and (math.abs(close - strong) <= nearAtr * atr or math.abs(close - weak) <= nearAtr * atr)
curCol = not barstate.isconfirmed ? na : waiting ? LPURPLE : evCur == 1 ? GREEN : evCur == 2 ? RED : evCur == 5 ? ORANGE : evCur == 6 ? iCol : evCur == 7 ? iColDn : nearLvl ? YELLOW : trend != 0 and pulled ? (close >= open ? color.white : color.black) : na
prevCol = not barstate.isconfirmed ? na : evPrev >= 3 and evPrev <= 4 ? PURPLE : evPrev == 5 ? ORANGE : na
barcolor(curCol)
barcolor(prevCol, offset=-1)

// premium / discount (fib STRONG -> WEAK, redrawn on every BOS / MS and whenever WEAK extends) + lines
var line  lS = na
var line  lW = na
var box   bP = na
var box   bD = na
var label tS = na
var label tW = na
if barstate.islast and trend != 0
    line.delete(lS)
    line.delete(lW)
    box.delete(bP)
    box.delete(bD)
    label.delete(tS)
    label.delete(tW)
    x1 = math.min(nz(sb, wb), wb)
    x2 = bar_index + 15
    mid = (strong + weak) / 2
    if showFib
        top = math.max(strong, weak)
        bot = math.min(strong, weak)
        bP := box.new(x1, top, x2, mid, border_color=color.new(RED, 80), bgcolor=color.new(RED, 90), text="PREMIUM", text_size=size.normal, text_color=color.new(color.white, 30), text_halign=text.align_right)
        bD := box.new(x1, mid, x2, bot, border_color=color.new(GREEN, 80), bgcolor=color.new(GREEN, 90), text="DISCOUNT", text_size=size.normal, text_color=color.new(color.white, 30), text_halign=text.align_right)
    if showLns
        lS := line.new(x1, strong, x2, strong, color=color.white, width=2)
        lW := line.new(x1, weak, x2, weak, color=color.gray, style=line.style_dotted, width=2)
        tS := label.new(x2, strong, "STRONG " + str.tostring(strong, format.mintick), style=label.style_label_left, color=color.rgb(70, 70, 70), textcolor=color.white, size=size.normal)
        tW := label.new(x2, weak, "WEAK " + str.tostring(weak, format.mintick), style=label.style_label_left, color=color.rgb(110, 110, 110), textcolor=color.white, size=size.normal)

// zones: supply with its 50% in premium, demand with its 50% in discount. A (where the move started) stands alone; the rest,
// farthest from price first (a tie: the bigger box first), join a group when their 50% is inside the group's first box.
// Each group = one box (lowest wick to highest wick), one letter: A, B, C ... per side.
var array<box> obBoxes = array.new_box()
f_side(sd, fm, aBar) =>
    idx = array.new_int()
    aIdx = -1
    for i = 0 to array.size(zTop) - 1
        zm = (array.get(zTop, i) + array.get(zBot, i)) / 2
        if array.get(zSide, i) == sd and (sd == 1 ? zm < fm : zm > fm)
            if array.get(zOb, i) == aBar
                aIdx := i
            else
                array.push(idx, i)
    // sort: farthest from price first, tie = bigger box first
    n = array.size(idx)
    if n > 1
        for p = 0 to n - 2
            for q = 0 to n - 2 - p
                i1 = array.get(idx, q)
                i2 = array.get(idx, q + 1)
                m1 = (array.get(zTop, i1) + array.get(zBot, i1)) / 2
                m2 = (array.get(zTop, i2) + array.get(zBot, i2)) / 2
                k1 = sd == 1 ? m1 : -m1
                k2 = sd == 1 ? m2 : -m2
                s1 = array.get(zTop, i1) - array.get(zBot, i1)
                s2 = array.get(zTop, i2) - array.get(zBot, i2)
                if k2 < k1 or (k2 == k1 and s2 > s1)
                    array.set(idx, q, i2)
                    array.set(idx, q + 1, i1)
    // groups: gTop / gBot = the merged box, fTop / fBot = the group's first box, gX = its oldest candle
    gTop = array.new_float()
    gBot = array.new_float()
    gX = array.new_int()
    if aIdx >= 0
        array.push(gTop, array.get(zTop, aIdx))
        array.push(gBot, array.get(zBot, aIdx))
        array.push(gX, array.get(zOb, aIdx))
    fTop = float(na)
    fBot = float(na)
    if n > 0
        for j = 0 to n - 1
            i = array.get(idx, j)
            zm = (array.get(zTop, i) + array.get(zBot, i)) / 2
            g = array.size(gTop) - 1
            if not na(fTop) and zm >= fBot and zm <= fTop
                array.set(gTop, g, math.max(array.get(gTop, g), array.get(zTop, i)))
                array.set(gBot, g, math.min(array.get(gBot, g), array.get(zBot, i)))
                array.set(gX, g, math.min(array.get(gX, g), array.get(zOb, i)))
            else
                fTop := array.get(zTop, i)
                fBot := array.get(zBot, i)
                array.push(gTop, fTop)
                array.push(gBot, fBot)
                array.push(gX, array.get(zOb, i))
    [gTop, gBot, gX]
if barstate.islast
    for bx in obBoxes
        box.delete(bx)
    array.clear(obBoxes)
    if showOB and trend != 0 and array.size(zTop) > 0
        fm = (strong + weak) / 2
        for sd in array.from(1, -1)
            if not obTrend or sd == trend
                [gTop, gBot, gX] = f_side(sd, fm, sd == 1 ? demA : supA)
                if array.size(gTop) > 0
                    for j = 0 to array.size(gTop) - 1
                        letter = j < 26 ? str.substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ", j, j + 1) : str.tostring(j + 1)
                        array.push(obBoxes, box.new(array.get(gX, j), array.get(gTop, j), bar_index + 15, array.get(gBot, j), border_color=color.black, border_width=2, bgcolor=color.new(sd == 1 ? GREEN : RED, 88), text=letter, text_size=size.normal, text_color=color.black))

// the 50% line: hot pink, solid, on top of the zone boxes, past them on the right with a "50%" tag (Jeff via Chrome, Oct 14)
var line  lM = na
var label tM = na
if barstate.islast
    line.delete(lM)
    label.delete(tM)
    if showFib and trend != 0
        fm = (strong + weak) / 2
        lM := line.new(math.min(nz(sb, wb), wb), fm, bar_index + 30, fm, color=midCol, width=3)
        tM := label.new(bar_index + 30, fm, "50%", style=label.style_label_left, color=midCol, textcolor=color.white, size=size.normal)

// TIER 2b: liquidity $$$
var float dHi = na
var float dLo = na
var float pdh = na
var float pdl = na
var int   dStart = na
var int   pdStart = na
if timeframe.change("D")
    pdh := dHi
    pdl := dLo
    pdStart := dStart
    dHi := high
    dLo := low
    dStart := bar_index
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
var array<float> topW = array.new_float()   // tops: wick (high), body top, candle, equal?
var array<float> topE = array.new_float()
var array<int>   topB = array.new_int()
var array<bool>  topQ = array.new_bool()
var array<float> uW = array.new_float()   // bottoms: wick (low), body bottom, candle, equal?
var array<float> uE = array.new_float()
var array<int>   uB = array.new_int()
var array<bool>  uQ = array.new_bool()
// checklist step 2: did this candle sweep a recent low (high) and close back? (checked before the wick removes it)
f_swept(arr, isLow) =>
    hit = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            L = array.get(arr, i)
            if isLow ? (low < L and close > L) : (high > L and close < L)
                hit := true
    hit
newDay = timeframe.change("D")
loLvl = trend[1] == 1 ? strong[1] : trend[1] == -1 ? weak[1] : na
hiLvl = trend[1] == 1 ? weak[1] : trend[1] == -1 ? strong[1] : na
swLo = f_swept(uW, true) or (not na(loLvl) and low < loLvl and close > loLvl) or (not na(pdl) and not newDay and nz(dLo[1], low) >= pdl and low < pdl and close > pdl)
swHi = f_swept(topW, false) or (not na(hiLvl) and high > hiLvl and close < hiLvl) or (not na(pdh) and not newDay and nz(dHi[1], high) <= pdh and high > pdh and close < pdh)
// a wick past it takes it
if array.size(topW) > 0
    for i = array.size(topW) - 1 to 0
        if high > array.get(topW, i)
            array.remove(topW, i)
            array.remove(topE, i)
            array.remove(topB, i)
            array.remove(topQ, i)
if array.size(uW) > 0
    for i = array.size(uW) - 1 to 0
        if low < array.get(uW, i)
            array.remove(uW, i)
            array.remove(uE, i)
            array.remove(uB, i)
            array.remove(uQ, i)
// new top: a green candle then a red candle
if close[1] > open[1] and close < open
    oj = high[1] >= high ? 1 : 0
    w = high[oj]
    if array.size(topW) > 0
        for i = 0 to array.size(topW) - 1
            if array.get(topE, i) <= w and w <= array.get(topW, i)
                array.set(topQ, i, true)
    array.push(topW, w)
    array.push(topE, math.max(open[oj], close[oj]))
    array.push(topB, bar_index - oj)
    array.push(topQ, false)
    if array.size(topW) > 300
        array.shift(topW)
        array.shift(topE)
        array.shift(topB)
        array.shift(topQ)
// new bottom: a red candle then a green candle
if close[1] < open[1] and close > open
    oj = low[1] <= low ? 1 : 0
    w = low[oj]
    if array.size(uW) > 0
        for i = 0 to array.size(uW) - 1
            if array.get(uW, i) <= w and w <= array.get(uE, i)
                array.set(uQ, i, true)
    array.push(uW, w)
    array.push(uE, math.min(open[oj], close[oj]))
    array.push(uB, bar_index - oj)
    array.push(uQ, false)
    if array.size(uW) > 300
        array.shift(uW)
        array.shift(uE)
        array.shift(uB)
        array.shift(uQ)
// leg $$$: the highest high (uptrend: lowest low) since the break before the latest break (BOS or MS), not counting
// that break candle. Stops for the whole leg sit past it (Jeff's SOL 1H Oct 11 "yellow candle" 113.33).
var int brkA = na   // the break before the latest
var int brkB = na   // the latest break
if evCur == 1 or evCur == 2 or evPrev == 3 or evPrev == 4
    brkA := brkB
    brkB := evCur == 1 or evCur == 2 ? bar_index : bar_index - 1
var array<line>  liqL = array.new_line()
var array<label> liqT = array.new_label()
f_liq(x1, y, txt) =>
    array.push(liqL, line.new(x1, y, bar_index + 22, y, color=liqCol, style=line.style_solid, width=2))
    array.push(liqT, label.new(bar_index + 22, y, txt, style=label.style_label_left, color=liqCol, textcolor=color.white, size=size.normal))
    true
// one side's equal levels since x0, one line per group (a level inside another level's wick is dropped)
f_eq(W, E, B, Q, x0) =>
    n = array.size(W)
    if n > 0
        for i = 0 to n - 1
            if array.get(Q, i) and array.get(B, i) >= x0
                y = array.get(W, i)
                inside = false
                for j = 0 to n - 1
                    if j != i and array.get(Q, j) and array.get(B, j) >= x0 and (array.get(W, j) != y or j < i)
                        lo = math.min(array.get(W, j), array.get(E, j))
                        hi = math.max(array.get(W, j), array.get(E, j))
                        if y >= lo and y <= hi
                            inside := true
                if not inside
                    f_liq(array.get(B, i), y, "$$$")
    true
if barstate.islast
    for x in liqL
        line.delete(x)
    for x in liqT
        label.delete(x)
    array.clear(liqL)
    array.clear(liqT)
    if showLiq
        if not na(pdh) and dHi <= pdh
            f_liq(nz(pdStart, bar_index), pdh, "D $$$")
        if not na(pdl) and dLo >= pdl
            f_liq(nz(pdStart, bar_index), pdl, "D $$$")
        if trend != 0 and not na(brkA) and bar_index - brkA <= 1500
            [legH, legHb] = f_hi(brkA + 1, 0)
            [legL, legLb] = f_lo(brkA + 1, 0)
            if trend == -1 and legH > strong
                f_liq(legHb, legH, "$$$")
            if trend == 1 and legL < strong
                f_liq(legLb, legL, "$$$")
        if trend != 0
            x0 = liqOld ? math.max(0, bar_index - 1500) : math.min(nz(sb, wb), wb)   // [Claude: older = last 1500 candles, TradingView's reach]
            f_eq(topW, topE, topB, topQ, x0)
            f_eq(uW, uE, uB, uQ, x0)

// CHECKLIST: READY / WAIT, LONG and SHORT side by side (see the notes at the top)
cMid = (strong + weak) / 2
// nearest untouched level above (below) ref: the $$$ the board draws (equal highs/lows), yesterday's high (low) if not taken, STRONG / WEAK
f_tgt(ref, isUp) =>
    t = float(na)
    arr = isUp ? topW : uW
    q = isUp ? topQ : uQ
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            L = array.get(arr, i)
            if array.get(q, i) and (isUp ? L > ref and (na(t) or L < t) : L < ref and (na(t) or L > t))
                t := L
    for L in array.from(strong, weak, isUp ? (dHi <= nz(pdh) ? pdh : na) : (dLo >= nz(pdl) ? pdl : na))
        if not na(L) and (isUp ? L > ref and (na(t) or L < t) : L < ref and (na(t) or L > t))
            t := L
    t
// LONG
var int   lSw = na      // sweep candle
var float lSL = na      // sweep low = stop
var bool  lDisc = false
var int   lMs = na      // shift candle
var bool  lTrue = false
var float lZ = na       // top of the zone that made the shift
var float lTg = na
var int   lPb = na
var int   lRd = na      // READY / SKIP candle
var float lEn = na
var float lRR = na
var string lEnd = ""
fireL = false
// SHORT (mirror)
var int   sSw = na
var float sSH = na
var bool  sPrem = false
var int   sMs = na
var bool  sTrue = false
var float sZ = na
var float sTg = na
var int   sPb = na
var int   sRd = na
var float sEn = na
var float sRR = na
var string sEnd = ""
fireS = false
if barstate.isconfirmed and trend != 0
    // ---- LONG ----
    if swLo and (na(lSw) or not na(lRd) or low <= lSL)
        lSw := bar_index
        lSL := low
        lDisc := low < cMid
        lMs := na
        lTrue := false
        lPb := na
        lRd := na
        lTg := na
        lEnd := ""
    else if not na(lSw) and na(lRd) and (close < lSL or evPrev == 4)
        lEnd := close < lSL ? "Off: closed below the sweep low" : "Off: MS down"
        lSw := na
        lMs := na
        lPb := na
    if not na(lSw) and na(lMs) and (evCur == 1 or evCur == 6 or (evPrev == 3 and bar_index - 1 >= lSw))
        lMs := evPrev == 3 ? bar_index - 1 : bar_index
        lTrue := evPrev == 3
        z = float(na)
        if lMs - 1 >= lSw
            for x = lMs - 1 to lSw
                o = bar_index - x
                if close[o] < open[o]
                    z := high[o]
                    break
        lZ := na(z) ? math.min(open[bar_index - lSw], close[bar_index - lSw]) : z
        lTg := f_tgt(close, true)
    else if not na(lMs) and na(lPb) and na(lRd) and bar_index > lMs
        if low <= lZ
            lPb := bar_index
        else if not na(lTg) and high >= lTg
            lEnd := "Off: target hit before the pullback"
            lSw := na
            lMs := na
    else if not na(lPb) and na(lRd) and bar_index > lPb
        if close > open and close > high[1]
            lRd := bar_index
            lEn := close
            lTg := f_tgt(close, true)
            lRR := na(lTg) ? na : (lTg - close) / math.max(close - lSL, syminfo.mintick)
            zoneOk = lDisc or lTrue
            fireL := zoneOk and (na(lRR) or lRR >= minRR)
            lEnd := fireL ? "READY" : not zoneOk ? "SKIP: sweep not in discount, no true MS" : "SKIP: R:R " + str.tostring(lRR, "#.#") + " under " + str.tostring(minRR, "#.#")
        else if not na(lTg) and high >= lTg
            lEnd := "Off: target hit before entry"
            lSw := na
            lMs := na
            lPb := na
    // ---- SHORT (mirror) ----
    if swHi and (na(sSw) or not na(sRd) or high >= sSH)
        sSw := bar_index
        sSH := high
        sPrem := high > cMid
        sMs := na
        sTrue := false
        sPb := na
        sRd := na
        sTg := na
        sEnd := ""
    else if not na(sSw) and na(sRd) and (close > sSH or evPrev == 3)
        sEnd := close > sSH ? "Off: closed above the sweep high" : "Off: MS up"
        sSw := na
        sMs := na
        sPb := na
    if not na(sSw) and na(sMs) and (evCur == 2 or evCur == 7 or (evPrev == 4 and bar_index - 1 >= sSw))
        sMs := evPrev == 4 ? bar_index - 1 : bar_index
        sTrue := evPrev == 4
        z = float(na)
        if sMs - 1 >= sSw
            for x = sMs - 1 to sSw
                o = bar_index - x
                if close[o] > open[o]
                    z := low[o]
                    break
        sZ := na(z) ? math.max(open[bar_index - sSw], close[bar_index - sSw]) : z
        sTg := f_tgt(close, false)
    else if not na(sMs) and na(sPb) and na(sRd) and bar_index > sMs
        if high >= sZ
            sPb := bar_index
        else if not na(sTg) and low <= sTg
            sEnd := "Off: target hit before the pullback"
            sSw := na
            sMs := na
    else if not na(sPb) and na(sRd) and bar_index > sPb
        if close < open and close < low[1]
            sRd := bar_index
            sEn := close
            sTg := f_tgt(close, false)
            sRR := na(sTg) ? na : (close - sTg) / math.max(sSH - close, syminfo.mintick)
            zoneOk = sPrem or sTrue
            fireS := zoneOk and (na(sRR) or sRR >= minRR)
            sEnd := fireS ? "READY" : not zoneOk ? "SKIP: sweep not in premium, no true MS" : "SKIP: R:R " + str.tostring(sRR, "#.#") + " under " + str.tostring(minRR, "#.#")
        else if not na(sTg) and low <= sTg
            sEnd := "Off: target hit before entry"
            sSw := na
            sMs := na
            sPb := na

plotshape(showChk and fireL, "READY long", shape.labelup, location.belowbar, GREEN, text="READY", textcolor=color.black, size=size.small)
plotshape(showChk and fireS, "READY short", shape.labeldown, location.abovebar, RED, text="READY", textcolor=color.white, size=size.small)
alertcondition(fireL, "READY long", "{{ticker}} {{interval}} READY LONG (Jeff checklist)")
alertcondition(fireS, "READY short", "{{ticker}} {{interval}} READY SHORT (Jeff checklist)")
if fireL
    alert(syminfo.ticker + " " + timeframe.period + " READY LONG  entry " + str.tostring(lEn, format.mintick) + "  stop " + str.tostring(lSL, format.mintick) + "  target " + str.tostring(lTg, format.mintick) + "  R:R " + str.tostring(lRR, "#.#"), alert.freq_once_per_bar_close)
if fireS
    alert(syminfo.ticker + " " + timeframe.period + " READY SHORT  entry " + str.tostring(sEn, format.mintick) + "  stop " + str.tostring(sSH, format.mintick) + "  target " + str.tostring(sTg, format.mintick) + "  R:R " + str.tostring(sRR, "#.#"), alert.freq_once_per_bar_close)

var table ck = table.new(position.bottom_right, 3, 8, bgcolor=color.new(color.black, 0), frame_color=color.gray, frame_width=1, border_width=2)
f_mark(ok) => ok ? "✓" : "✗"
f_tm(b) => str.format_time(time[bar_index - b], "MMM d HH:mm", "America/New_York")
f_status(fire, sw, ms, pb, rd, endTxt, isL) =>
    fire ? "READY " + (isL ? "LONG" : "SHORT") : not na(rd) ? (endTxt == "READY" ? "Done: READY " + f_tm(rd) + " (one try)" : endTxt) : na(sw) ? "WAIT: no sweep of a " + (isL ? "low" : "high") + " yet" : na(ms) ? "WAIT: no 15m MS " + (isL ? "up" : "down") + " yet" : na(pb) ? "WAIT: pullback to the zone" : "WAIT: confirm candle"
if barstate.islast and showChk
    lZoneNow = na(lSw) ? close < cMid : lDisc or lTrue
    sZoneNow = na(sSw) ? close > cMid : sPrem or sTrue
    lRRnow = not na(lRd) ? lRR : not na(lMs) and not na(lTg) ? (lTg - close) / math.max(close - lSL, syminfo.mintick) : na
    sRRnow = not na(sRd) ? sRR : not na(sMs) and not na(sTg) ? (close - sTg) / math.max(sSH - close, syminfo.mintick) : na
    rows = array.from("1 Zone", "2 Sweep", "3 MS", "4 Pullback", "5 Confirm")
    lOk = array.from(lZoneNow, not na(lSw), not na(lMs), not na(lPb), not na(lRd) and lEnd == "READY")
    sOk = array.from(sZoneNow, not na(sSw), not na(sMs), not na(sPb), not na(sRd) and sEnd == "READY")
    table.cell(ck, 0, 0, "CHECKLIST", text_color=color.white, text_size=size.small)
    table.cell(ck, 1, 0, "LONG", text_color=GREEN, text_size=size.small)
    table.cell(ck, 2, 0, "SHORT", text_color=RED, text_size=size.small)
    for i = 0 to 4
        table.cell(ck, 0, i + 1, array.get(rows, i), text_color=color.white, text_size=size.small, text_halign=text.align_left)
        lo = array.get(lOk, i)
        so = array.get(sOk, i)
        lT = f_mark(lo) + (i == 2 and lTrue and not na(lMs) ? " TRUE" : "")
        sT = f_mark(so) + (i == 2 and sTrue and not na(sMs) ? " TRUE" : "")
        table.cell(ck, 1, i + 1, lT, text_color=lo ? GREEN : color.gray, text_size=size.small)
        table.cell(ck, 2, i + 1, sT, text_color=so ? GREEN : color.gray, text_size=size.small)
    table.cell(ck, 0, 6, "R:R " + str.tostring(minRR, "#.#") + "+", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(ck, 1, 6, na(lRRnow) ? "-" : str.tostring(lRRnow, "#.#"), text_color=na(lRRnow) ? color.gray : lRRnow >= minRR ? GREEN : YELLOW, text_size=size.small)
    table.cell(ck, 2, 6, na(sRRnow) ? "-" : str.tostring(sRRnow, "#.#"), text_color=na(sRRnow) ? color.gray : sRRnow >= minRR ? GREEN : YELLOW, text_size=size.small)
    lSt = f_status(fireL, lSw, lMs, lPb, lRd, lEnd, true)
    sSt = f_status(fireS, sSw, sMs, sPb, sRd, sEnd, false)
    table.cell(ck, 1, 7, lSt, text_color=fireL ? color.black : color.white, bgcolor=fireL ? GREEN : na, text_size=size.small)
    table.cell(ck, 2, 7, sSt, text_color=fireS ? color.white : color.white, bgcolor=fireS ? RED : na, text_size=size.small)
    table.cell(ck, 0, 7, "Look past stop (17b)", text_color=YELLOW, text_size=size.tiny, text_halign=text.align_left)

// small top-right box (trend + phase) and the color key laid on its side along the bottom
var table tb  = table.new(position.top_right, 1, 3, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=1, border_width=2)
var table key = table.new(position.bottom_center, 20, 1, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=1, border_width=2)
keyCell(i, c, t) =>
    table.cell(key, 2 * i, 0, "  ", bgcolor=c, text_size=size.small)
    table.cell(key, 2 * i + 1, 0, t, text_color=color.white, text_size=size.small)
if barstate.islast and showBox
    tTxt = trend == 1 ? "Trend UP: buyers in control" : trend == -1 ? "Trend DOWN: sellers in control" : "Waiting for structure"
    pTxt = trend == 0 ? "" : pulled ? "Pullback: holds while " + (trend == 1 ? "above " : "below ") + str.tostring(strong, format.mintick) : "Moving " + (trend == 1 ? "up" : "down") + ", new " + (trend == 1 ? "high " : "low ") + str.tostring(weak, format.mintick)
    if waiting
        pTxt := "MS? 1st close past " + str.tostring(strong, format.mintick) + " - next close decides"
    table.cell(tb, 0, 0, tTxt, text_color=trend == 1 ? GREEN : trend == -1 ? RED : color.white, text_size=size.normal)
    table.cell(tb, 0, 1, pTxt, text_color=color.white, text_size=size.small)
    tf = timeframe.isintraday and timeframe.multiplier % 60 == 0 ? str.tostring(timeframe.multiplier / 60, "#") + "H" : timeframe.period
    s4 = t4 == 1 ? "UP" : t4 == -1 ? "DOWN" : "?"
    sC = trend == 1 ? "UP" : trend == -1 ? "DOWN" : "?"
    vs = t4 == 0 or trend == 0 ? "" : t4 == trend ? "  (with 4H)" : "  (against 4H = likely pullback)"
    table.cell(tb, 0, 2, "4H: " + s4 + "  |  " + tf + ": " + sC + vs, text_color=t4 == trend ? GREEN : YELLOW, text_size=size.small)
    keyCell(0, GREEN, "BOS up")
    keyCell(1, RED, "BOS down")
    keyCell(2, PURPLE, "MS flip")
    keyCell(9, LPURPLE, "MS? 1st close")
    keyCell(3, iCol, "Internal up")
    keyCell(4, iColDn, "Internal down")
    keyCell(5, ORANGE, "Sweep")
    keyCell(6, color.white, "Pullback buy")
    keyCell(7, color.black, "Pullback sell")
    keyCell(8, YELLOW, "Watch")
