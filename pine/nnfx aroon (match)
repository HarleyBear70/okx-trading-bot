// NNFX Aroon — matches Jeff's nnfx-okx bot (bot.py analyse_nnfx + check_hit + manage_on_close). Use on a DAILY chart.
// Buy: at the daily close when Aroon(25) flips up (Aroon up > Aroon down, after not being up the day before).
// Stop: 1.5 x ATR(14) under the entry close. Half sold at +1 x ATR; then the rest's stop goes to the entry price.
// Exit the rest: at any daily close where Aroon is down (Aroon down > Aroon up).
// Fees 0.35% per side (OKX spot, real). Risk 0.5% of balance per trade. The bot trades BTC, ETH and XRP from one
// shared balance; this chart tests one coin.
//@version=6
strategy("NNFX Aroon (bot match)", shorttitle="NNFX bot", overlay=true, initial_capital=1000,
     commission_type=strategy.commission.percent, commission_value=0.35, slippage=0,
     pyramiding=0, process_orders_on_close=true)

aroonLen = input.int(25, "Aroon length", minval=2)
atrLen   = input.int(14, "ATR length", minval=1)
stopAtr  = input.float(1.5, "Stop (x ATR)", step=0.1)
halfAtr  = input.float(1.0, "Sell half at (x ATR above entry)", step=0.1)
riskPct  = input.float(0.5, "Risk per trade (% of balance)", step=0.05)

// Bars since the highest high / lowest low of the last len+1 bars (newest one wins a tie, like bot.py)
barsSinceHigh(len) =>
    int best = 0
    for j = 1 to len
        if high[j] > high[best]
            best := j
    best

barsSinceLow(len) =>
    int best = 0
    for j = 1 to len
        if low[j] < low[best]
            best := j
    best

// Aroon direction, same as bot.py aroon_dir: +1 when up > down, -1 when down > up, unchanged on a tie
var int dir = 0
if bar_index >= aroonLen
    aUp = 100.0 * (aroonLen - barsSinceHigh(aroonLen)) / aroonLen
    aDn = 100.0 * (aroonLen - barsSinceLow(aroonLen)) / aroonLen
    dir := aUp > aDn ? 1 : aDn > aUp ? -1 : dir

atr    = ta.atr(atrLen)
flipUp = dir == 1 and nz(dir[1]) != 1

var float entryPx  = na
var float stopLvl  = na
var float halfAt   = na
var float fullQty  = na
var bool  halfDone = false

inPos = strategy.position_size > 0

// Half sold since the last close? The rest's stop goes to the entry price (bot: be_after_half)
if inPos and not halfDone and strategy.position_size < fullQty * 0.99
    halfDone := true
    stopLvl  := math.max(stopLvl, entryPx)

// Aroon down at the close: sell the rest
if inPos and dir == -1
    strategy.close("Long", comment="Aroon down")

// Buy at the close on an Aroon flip up
enteredNow = false
if not inPos and flipUp and not na(atr) and barstate.isconfirmed
    sl      = close - stopAtr * atr
    balance = strategy.initial_capital + strategy.netprofit
    qty     = math.min(balance * riskPct / 100 / (close - sl), balance / close)
    strategy.entry("Long", strategy.long, qty=qty, comment="Aroon up")
    entryPx    := close
    stopLvl    := sl
    halfAt     := close + halfAtr * atr
    fullQty    := qty
    halfDone   := false
    enteredNow := true

// Resting orders for the next candle: stop (and the half sell until it fills)
if (inPos and dir != -1) or enteredNow
    if not halfDone
        strategy.exit("Half", "Long", qty_percent=50, limit=halfAt, stop=stopLvl, comment_profit="Half +1 ATR", comment_loss="Stop")
        strategy.exit("Stop", "Long", stop=stopLvl, comment="Stop")
    else
        strategy.exit("Stop", "Long", stop=stopLvl, comment="Breakeven stop")

showLines = inPos or enteredNow
plot(showLines ? stopLvl : na, "Stop", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showLines and not halfDone ? halfAt : na, "Half-sell target", color=color.green, linewidth=1, style=plot.style_linebr)
plot(showLines ? entryPx : na, "Entry", color=color.gray, linewidth=1, style=plot.style_linebr)
bgcolor(dir == 1 ? color.new(color.green, 94) : dir == -1 ? color.new(color.red, 94) : na, title="Aroon direction")
