// Donchian Trend — matches Jeff's dc-okx bot (bot.py analyse_donchian + manage_on_close). Use on a DAILY chart.
// Buy: daily close above the prior 20-day high (for ETH/SOL/XRP/BNB only while BTC's daily close is above its 50 EMA).
// Stop: 2 x ATR(20) under the entry close, then trails at the lowest low of the last 10 days (only ever up).
// Add-on: once per trade, when a close is 1R above entry, buy one more piece (same risk) and lift the stop to entry.
// Fees 0.35% per side (OKX spot, real). Note: the bot shares one balance across 5 coins; this chart tests one coin.
//@version=6
strategy("Donchian Trend (bot match)", shorttitle="DC bot", overlay=true, initial_capital=1000,
     commission_type=strategy.commission.percent, commission_value=0.35, slippage=0,
     pyramiding=1, process_orders_on_close=true)

entryLen  = input.int(20, "Entry: prior N-day high", minval=2)
exitLen   = input.int(10, "Trail: lowest low of N days", minval=2)
atrLen    = input.int(20, "ATR length", minval=1)
stopAtr   = input.float(2.0, "First stop (x ATR)", step=0.1)
riskPct   = input.float(0.32, "Risk per piece (% of balance)", step=0.01)
usePyr    = input.bool(true, "Add-on at +1R (pyramid)")
useLeash  = input.bool(true, "BTC leash (alts buy only when BTC > its 50 EMA)")
leashSym  = input.symbol("OKX:BTCUSDT", "BTC symbol for the leash")

atr    = ta.atr(atrLen)
hiPrev = ta.highest(high, entryLen)[1]
trail  = ta.lowest(low, exitLen)
isBtc  = str.contains(str.upper(syminfo.basecurrency), "BTC")
btcUp  = request.security(leashSym, "D", close > ta.ema(close, 50), lookahead=barmerge.lookahead_off)
leashOk  = not useLeash or isBtc or btcUp
breakout = close > hiPrev and barstate.isconfirmed
longSig  = breakout and leashOk

var float stopLvl = na
var float entryPx = na
var float oneR    = na
var bool  added   = false
bool flat = strategy.position_size == 0

if flat and not longSig
    stopLvl := na
    added   := false

if flat and longSig and atr > 0
    float sl  = close - stopAtr * atr
    float qty = math.min(strategy.equity * riskPct / 100 / (close - sl), strategy.equity / close)
    strategy.entry("DC", strategy.long, qty=qty, comment="20-day high")
    entryPx := close
    oneR    := close - sl
    stopLvl := sl
    added   := false
else if not flat
    stopLvl := math.max(stopLvl, trail)
    if usePyr and not added and close >= entryPx + oneR and close > stopLvl
        float inUse = strategy.position_size * close
        float qty2  = math.min(strategy.equity * riskPct / 100 / (close - stopLvl), math.max(strategy.equity - inUse, 0) / close)
        if qty2 * close >= 5
            strategy.entry("DC add", strategy.long, qty=qty2, comment="add +1R")
        added   := true
        stopLvl := math.max(stopLvl, entryPx)

if not na(stopLvl)
    strategy.exit("Stop", "DC", stop=stopLvl, comment="stop")
    strategy.exit("Stop add", "DC add", stop=stopLvl, comment="stop")

plot(hiPrev, "Prior 20-day high (buy line)", color=color.new(color.green, 30), style=plot.style_stepline)
plot(trail, "10-day low (trail line)", color=color.new(color.red, 60), style=plot.style_stepline)
plot(stopLvl, "Bot's stop", color=color.red, linewidth=2, style=plot.style_linebr)
plotshape(breakout and not leashOk and flat, "Blocked by BTC leash", shape.xcross, location.belowbar, color.gray, size=size.tiny)
bgcolor(useLeash and not isBtc and not btcUp ? color.new(color.gray, 90) : na, title="BTC below its 50 EMA (alts paused)")
