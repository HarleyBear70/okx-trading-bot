//@version=5
// Jeff's Command Center — everything in ONE indicator (one chart slot):
//  1. Trend dashboard: daily trend, 4H trend, 50-day average, RSI, SP-12 v2 checklist + net score, Trend Rider status
//  2. Trend Rider buys + its trailing stop line, tagged with POC tap / heavy volume / low-volume-gap warning
//  3. SP-12 v2 buys with stop and target lines (same rules as the SP-12 v2 strategy / demo bot)
//  4. Volume profile of the last swing low -> swing high (POC, value area, low-volume gaps)
//  5. Higher-timeframe candles to the right of price with delta + countdown
//  6. Optional: delta under each candle, sweep markers
// Built for 4H charts (bots run on 4H). For viewing only — it does not place trades.
// Keep the "SP-12 v2" STRATEGY script saved for Strategy Tester backtests; add it only when testing.
indicator("Jeff's Command Center", shorttitle="Command Center", overlay=true,
     max_labels_count=500, max_boxes_count=200, max_lines_count=200, max_bars_back=1000)

// ───────── Settings ─────────
gS = "Show / hide"
showDash  = input.bool(true,  "Trend dashboard", group=gS)
showTR    = input.bool(true,  "Trend Rider buys + trailing stop", group=gS)
showSP    = input.bool(true,  "SP-12 v2 buys + stop/target", group=gS)
showProf  = input.bool(true,  "Volume profile (POC)", group=gS)
showHTF   = input.bool(true,  "Higher-timeframe candles + countdown", group=gS)
showBarD  = input.bool(false, "Delta under each candle", group=gS)
showSweep = input.bool(false, "Sweep markers", group=gS)

gT = "Trend Rider"
L        = input.int(5, "Swing strength (5 crypto, 3 gold)", minval=2, maxval=15, group=gT)
volMult  = input.float(1.5, "Heavy volume = this x 20-bar average", step=0.1, group=gT)

gP = "Volume profile"
nBins    = input.int(40, "Profile rows", minval=10, maxval=80, group=gP)

gH = "Higher-timeframe candles"
tf1      = input.timeframe("60", "Timeframe 1", group=gH)
tf2      = input.timeframe("240", "Timeframe 2", group=gH)
tf3      = input.timeframe("D", "Timeframe 3", group=gH)
nCandles = input.int(4, "Candles per timeframe", minval=1, maxval=8, group=gH)
gap      = input.int(5, "Space from price (bars)", minval=1, maxval=50, group=gH)
cw       = input.int(2, "Candle width (bars)", minval=1, maxval=5, group=gH)
ltfIn    = input.timeframe("15", "Lower timeframe used to measure delta", group=gH)
nLabels  = input.int(100, "Candles with a delta label", minval=10, maxval=300, group=gH)

upCol = color.teal
dnCol = color.red

// ───────── Shared calculations ─────────
atr14  = ta.atr(14)
ema50  = ta.ema(close, 50)
avgVol = ta.sma(volume, 20)[1]
heavy  = volume > volMult * avgVol
rsi14  = ta.rsi(close, 14)
[stLine, stDir] = ta.supertrend(3, 10)
[macdLine, sigLine, hist] = ta.macd(close, 12, 26, 9)

supertrendDir() =>
    [_st, _d] = ta.supertrend(3, 10)
    _d[1]
dClose  = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
dEma50  = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
dSma50  = request.security(syminfo.tickerid, "D", ta.sma(close, 50)[1], lookahead=barmerge.lookahead_on)
dEma20  = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
dEma20p = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[2], lookahead=barmerge.lookahead_on)
h4Close = request.security(syminfo.tickerid, "240", close[1], lookahead=barmerge.lookahead_on)
h4Ema   = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
h4Dir   = request.security(syminfo.tickerid, "240", supertrendDir(), lookahead=barmerge.lookahead_on)

dailyTR  = dClose > dEma50                       // Trend Rider daily filter
dailySP  = dClose > dEma20 and dEma20 > dEma20p  // SP-12 v2 daily check
above50d = dClose > dSma50                       // research rule: above the 50-day average
h4Up     = h4Close > h4Ema and h4Dir < 0

// ───────── Delta ─────────
ltf = timeframe.in_seconds(ltfIn) <= timeframe.in_seconds(timeframe.period) ? ltfIn : timeframe.period
dArr = request.security_lower_tf(syminfo.tickerid, ltf, close > open ? volume : close < open ? -volume : 0.0)
rng = high - low
delta = array.size(dArr) > 0 ? array.sum(dArr) : (rng > 0 ? nz(volume) * (close - open) / rng : 0.0)

fmt(float v) =>
    a = math.abs(v)
    s = a >= 1e9 ? str.tostring(a / 1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(a / 1e6, "#.##") + "M" : a >= 1e3 ? str.tostring(a / 1e3, "#.#") + "K" : str.tostring(a, "#.##")
    (v >= 0 ? "+" : "-") + s

// ───────── Swings ─────────
var float ph = na
var int   phIdx = na
var float pl = na
var int   plIdx = na
pH = ta.pivothigh(high, L, L)
pL = ta.pivotlow(low, L, L)
newHigh = not na(pH)
if not na(pL)
    pl := pL
    plIdx := bar_index - L

// ───────── Volume profile of last swing low -> swing high ─────────
var array<float> bins = array.new_float(0)
var array<box>   pBoxes = array.new_box(0)
var line  pocLine = na
var line  vahLine = na
var line  valLine = na
var float pLo = na
var float pW  = na
var float pMax = na
var float poc = na

if newHigh
    ph := pH
    phIdx := bar_index - L
    if not na(plIdx) and plIdx < phIdx and phIdx - plIdx <= 400 and ph > pl
        lo = pl
        hi = ph
        w = (hi - lo) / nBins
        array.clear(bins)
        for k = 0 to nBins - 1
            array.push(bins, 0.0)
        for idx = plIdx to phIdx
            off = bar_index - idx
            bh = math.min(high[off], hi)
            bl = math.max(low[off], lo)
            v = nz(volume[off])
            k0 = math.max(0, math.min(nBins - 1, int((bl - lo) / w)))
            k1 = math.max(0, math.min(nBins - 1, int((bh - lo) / w)))
            a0 = math.min(k0, k1)
            a1 = math.max(k0, k1)
            share = v / (a1 - a0 + 1)
            for k = a0 to a1
                array.set(bins, k, array.get(bins, k) + share)
        pk = 0
        for k = 1 to nBins - 1
            if array.get(bins, k) > array.get(bins, pk)
                pk := k
        total = array.sum(bins)
        lowK = pk
        highK = pk
        acc = array.get(bins, pk)
        while acc < 0.7 * total
            up = highK + 1 < nBins ? array.get(bins, highK + 1) : -1.0
            dn = lowK - 1 >= 0 ? array.get(bins, lowK - 1) : -1.0
            if up < 0 and dn < 0
                break
            if up >= dn
                highK += 1
                acc += up
            else
                lowK -= 1
                acc += dn
        pLo := lo
        pW := w
        pMax := array.get(bins, pk)
        poc := lo + (pk + 0.5) * w
        vah = lo + (highK + 1) * w
        val = lo + lowK * w
        for b in pBoxes
            box.delete(b)
        array.clear(pBoxes)
        line.delete(pocLine)
        line.delete(vahLine)
        line.delete(valLine)
        if showProf
            span = math.max(5, phIdx - plIdx)
            for k = 0 to nBins - 1
                bv = array.get(bins, k)
                len = int(span * bv / pMax)
                if len > 0
                    col = bv < 0.25 * pMax ? color.new(color.orange, 60) : (k >= lowK and k <= highK ? color.new(color.blue, 75) : color.new(color.gray, 70))
                    array.push(pBoxes, box.new(plIdx, lo + (k + 1) * w, plIdx + len, lo + k * w, border_color=col, bgcolor=col))
            pocLine := line.new(plIdx, poc, bar_index, poc, extend=extend.right, color=color.red, width=2)
            vahLine := line.new(plIdx, vah, bar_index, vah, extend=extend.right, color=color.new(color.blue, 30), style=line.style_dashed)
            valLine := line.new(plIdx, val, bar_index, val, extend=extend.right, color=color.new(color.blue, 30), style=line.style_dashed)

// ───────── Trend Rider: signal + trailing stop ─────────
breakout = not na(ph) and close > ph and close[1] <= ph
trBuy    = barstate.isconfirmed and breakout and close > ema50 and dailyTR

var bool  trIn = false
var float trStop = na
var float trHi = na
var float trEntry = na
if trIn
    if low <= trStop
        trIn := false
        if showTR
            label.new(bar_index, high, "TR exit\n" + str.tostring((trStop / trEntry - 1) * 100, "#.#") + "%", style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny)
    else if barstate.isconfirmed
        trHi := math.max(trHi, close)
        trStop := math.max(trStop, trHi - 3 * atr14)
if trBuy and not trIn
    s0 = na(pl) ? close - 2 * atr14 : pl * 0.998
    s0 := math.min(math.max(s0, close - 3 * atr14), close - atr14)
    trIn := true
    trStop := s0
    trHi := close
    trEntry := close
    if showTR
        pb = low[1]
        nb = bar_index - phIdx - 1
        if nb > 1
            for k = 1 to math.min(nb, 400)
                pb := math.min(pb, low[k])
        tags = ""
        if not na(poc) and math.abs(pb - poc) <= atr14
            tags += "\nPOC tap ✓"
        if heavy
            tags += "\nHeavy volume ✓"
        if not na(pW) and pb > pLo
            kk = int((pb - pLo) / pW)
            if kk >= 0 and kk < array.size(bins) and array.get(bins, kk) < 0.25 * pMax
                tags += "\nLow-volume gap ⚠"
        label.new(bar_index, low, "TR BUY" + tags, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
plot(showTR and trIn ? trStop : na, "Trend Rider trailing stop", color=color.orange, style=plot.style_linebr, linewidth=2)

// ───────── SP-12 v2: checks, score, signal ─────────
var float lastPH = na
var float lastPL = na
if not na(pH)
    lastPH := pH
if not na(pL)
    lastPL := pL
var int   bosBar = na
var int   sweepBar = na
var float obTop = na
var float obBot = na
var int   obBar = na
var float fvgTop = na
var float fvgBot = na
var int   fvgBar = na
bosUp = not na(lastPH) and close > lastPH and close[1] <= lastPH
if bosUp
    bosBar := bar_index
    obTop := na
    obBot := na
    for k = 1 to 10
        if close[k] < open[k]
            obTop := high[k]
            obBot := low[k]
            obBar := bar_index
            break
if low > high[2]
    fvgTop := low
    fvgBot := high[2]
    fvgBar := bar_index
swept = not na(lastPL) and low < lastPL and close > lastPL
if swept
    sweepBar := bar_index

body   = math.abs(close - open)
lowerW = math.min(close, open) - low
upperW = high - math.max(close, open)
engulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
hammer = body > 0 and lowerW >= 2 * body and upperW <= body
cBos   = not na(bosBar) and bar_index - bosBar <= 20
cFvg   = not na(fvgBar) and bar_index > fvgBar and bar_index - fvgBar <= 30 and low <= fvgTop and close >= fvgBot
cOb    = not na(obBar) and bar_index > obBar and bar_index - obBar <= 30 and low <= obTop and close >= obBot
cSweep = not na(sweepBar) and bar_index - sweepBar <= 10
cCandle = engulf or hammer
cSt    = stDir < 0
cMacd  = hist > hist[1]
bi(x) => x ? 1 : 0
spScore = bi(dailySP) + bi(cSweep) + bi(cSt) + bi(cMacd) - bi(cBos) - bi(cFvg) - bi(cOb) - bi(cCandle)
swingStop = ta.lowest(low, 10) * (1 - 0.001)
rawRisk = (close - swingStop) / close * 100
riskUse = math.max(rawRisk, 1.5)
tpPct   = math.min(math.max(2.5 * riskUse, 3.0), 10.0)

var bool  spIn = false
var float spSL = na
var float spTP = na
var int   spBar = na
if spIn
    hitSL = low <= spSL
    hitTP = high >= spTP
    if hitSL or hitTP or bar_index - spBar >= 60
        spIn := false
spBuy = barstate.isconfirmed and not spIn and h4Up and spScore >= 2 and rawRisk <= 4.0
if spBuy
    spIn := true
    spSL := close * (1 - riskUse / 100)
    spTP := close * (1 + tpPct / 100)
    spBar := bar_index
    if showSP
        label.new(bar_index, low, "SP-12 v2 BUY (net " + str.tostring(spScore) + ")\nSL -" + str.tostring(riskUse, "#.#") + "%  TP +" + str.tostring(tpPct, "#.#") + "%", style=label.style_label_up, color=color.new(color.blue, 10), textcolor=color.white, size=size.small)
plot(showSP and spIn ? spSL : na, "SP-12 v2 stop", color=color.red, style=plot.style_linebr)
plot(showSP and spIn ? spTP : na, "SP-12 v2 target", color=color.green, style=plot.style_linebr)

// ───────── Sweep markers (optional) ─────────
ref20 = ta.lowest(low, 20)[1]
sw20 = barstate.isconfirmed and low < ref20 and close > ref20
plotshape(showSweep and sw20, "Sweep", shape.triangleup, location.belowbar, heavy ? color.teal : color.new(color.teal, 50), size=size.tiny, text="sweep")

// ───────── Delta under each candle (optional) ─────────
var array<label> barLabs = array.new<label>()
var label liveLab = na
if showBarD
    if barstate.isconfirmed
        array.push(barLabs, label.new(bar_index, low, fmt(delta), style=label.style_label_up, color=color.new(color.black, 100), textcolor=delta >= 0 ? upCol : dnCol, size=size.tiny))
        if array.size(barLabs) > nLabels
            label.delete(array.shift(barLabs))
        label.delete(liveLab)
        liveLab := na
    else
        label.delete(liveLab)
        liveLab := label.new(bar_index, low, fmt(delta), style=label.style_label_up, color=color.new(color.black, 100), textcolor=delta >= 0 ? upCol : dnCol, size=size.tiny)

// ───────── Higher-timeframe candles ─────────
type Htf
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    array<float> d

newHtf() =>
    Htf.new(array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float())

method update(Htf x, bool isNew) =>
    if isNew or array.size(x.o) == 0
        array.unshift(x.o, open)
        array.unshift(x.h, high)
        array.unshift(x.l, low)
        array.unshift(x.c, close)
        array.unshift(x.d, delta)
        if array.size(x.o) > nCandles
            array.pop(x.o)
            array.pop(x.h)
            array.pop(x.l)
            array.pop(x.c)
            array.pop(x.d)
        true
    else
        array.set(x.h, 0, math.max(array.get(x.h, 0), high))
        array.set(x.l, 0, math.min(array.get(x.l, 0), low))
        array.set(x.c, 0, close)
        array.set(x.d, 0, array.get(x.d, 0) + delta)
        true

var Htf hA = newHtf()
var Htf hB = newHtf()
var Htf hC = newHtf()
hA.update(timeframe.change(tf1))
hB.update(timeframe.change(tf2))
hC.update(timeframe.change(tf3))

tfName(string tf) =>
    mins = timeframe.in_seconds(tf) / 60
    mins < 60 ? str.tostring(mins) + "m" : mins < 1440 ? str.tostring(mins / 60) + "H" : mins < 10080 ? str.tostring(mins / 1440) + "D" : "W"

countdown(string tf) =>
    ms = time_close(tf) - timenow
    s = math.max(0, int(ms / 1000))
    hh = int(s / 3600)
    mm = int((s % 3600) / 60)
    ss = s % 60
    hh > 0 ? str.tostring(hh) + "h " + str.tostring(mm) + "m" : str.tostring(mm) + "m " + str.tostring(ss) + "s"

var array<box>   hBx = array.new_box()
var array<line>  hLn = array.new_line()
var array<label> hLb = array.new_label()

drawGroup(Htf x, int baseX, string tf) =>
    n = array.size(x.o)
    top = array.max(x.h)
    for k = 0 to n - 1
        o = array.get(x.o, k)
        hv = array.get(x.h, k)
        lv = array.get(x.l, k)
        c = array.get(x.c, k)
        d = array.get(x.d, k)
        xl = baseX + (n - 1 - k) * (cw + 1)
        xm = xl + int((cw - 1) / 2)
        col = c >= o ? upCol : dnCol
        array.push(hLn, line.new(xm, hv, xm, lv, color=col, width=1))
        array.push(hBx, box.new(xl, math.max(o, c), xl + cw - 1, math.min(o, c), border_color=col, bgcolor=k == 0 ? color.new(col, 40) : col))
        array.push(hLb, label.new(xm, lv, fmt(d), style=label.style_label_up, color=color.new(color.black, 100), textcolor=d >= 0 ? upCol : dnCol, size=size.tiny))
    array.push(hLb, label.new(baseX + int((n * (cw + 1)) / 2), top, tfName(tf) + "\n" + countdown(tf), style=label.style_label_down, color=color.new(color.gray, 80), textcolor=chart.fg_color, size=size.small))

if barstate.islast
    for b in hBx
        box.delete(b)
    for ln in hLn
        line.delete(ln)
    for t in hLb
        label.delete(t)
    array.clear(hBx)
    array.clear(hLn)
    array.clear(hLb)
    if showHTF
        step = nCandles * (cw + 1) + 4
        drawGroup(hA, bar_index + gap, tf1)
        drawGroup(hB, bar_index + gap + step, tf2)
        drawGroup(hC, bar_index + gap + 2 * step, tf3)

// ───────── Dashboard ─────────
var table dash = table.new(position.top_right, 2, 16, border_width=1)
cell(int r, string name, string val, color vc) =>
    table.cell(dash, 0, r, name, text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(dash, 1, r, val, text_color=vc, bgcolor=color.new(color.black, 30), text_size=size.small)
ok(bool x) => x ? "✔" : "✘"
oc(bool x) => x ? color.lime : color.red

if showDash and barstate.islast
    cell(0,  "TREND", "", color.white)
    cell(1,  "Daily trend (TR)", ok(dailyTR), oc(dailyTR))
    cell(2,  "4H trend", ok(h4Up), oc(h4Up))
    cell(3,  "Above 50-day avg", ok(above50d), oc(above50d))
    cell(4,  "RSI 14", str.tostring(rsi14, "#"), rsi14 > 70 ? color.orange : rsi14 < 30 ? color.aqua : color.white)
    cell(5,  "SP-12 v2  (net " + str.tostring(spScore) + ", need 2)", spIn ? "IN TRADE" : spScore >= 2 and h4Up ? "READY" : "wait", spIn ? color.aqua : spScore >= 2 and h4Up ? color.lime : color.gray)
    cell(6,  "  + Daily up", ok(dailySP), oc(dailySP))
    cell(7,  "  + Liquidity sweep", ok(cSweep), oc(cSweep))
    cell(8,  "  + Supertrend up", ok(cSt), oc(cSt))
    cell(9,  "  + MACD rising", ok(cMacd), oc(cMacd))
    cell(10, "  − Recent BOS", ok(cBos), cBos ? color.red : color.gray)
    cell(11, "  − Tapped FVG", ok(cFvg), cFvg ? color.red : color.gray)
    cell(12, "  − Tapped order block", ok(cOb), cOb ? color.red : color.gray)
    cell(13, "  − Bull candle", ok(cCandle), cCandle ? color.red : color.gray)
    cell(14, "Trend Rider", trIn ? "IN TRADE, stop " + str.tostring(trStop, format.mintick) : "waiting", trIn ? color.aqua : color.gray)
    cell(15, "POC", na(poc) ? "-" : str.tostring(poc, format.mintick), color.red)

alertcondition(trBuy, "Trend Rider buy", "Trend Rider buy on {{ticker}}")
alertcondition(spBuy, "SP-12 v2 buy", "SP-12 v2 buy on {{ticker}}")
