// Jeff's Smoke Detector v23 (Oct 10 2026): a clean chart that only speaks up when something important is happening.
// CANDLE COLORS (Jeff's list, each one has an on/off switch in the settings):
//   B  WHITE  = buyers: a normal candle that closed UP.
//   S  BLACK  = sellers: a normal candle that closed DOWN.
//   BOS▲ GREEN / BOS▼ RED = a candle BODY closed past the newest leg's high (low) after a pullback: trend continues.
//   MS PURPLE = market shift: a candle BODY closed past STRONG's WICK (MUST HOLD) and the next candle did NOT close back
//            inside (Jeff's rule). The purple shows one candle later, on the candle that broke.
//   FO ORANGE = fake-out / fuel grab: a WICK went past the leg high/low, equal highs/lows or MUST HOLD but the body
//            closed back inside (a sweep), a break that the next candle undid, or a BOS undone within 3 candles.
//   No grey, no yellow, no blue/pink early turns (Jeff, Oct 10).
// STRUCTURE = Jeff's "heartbeat", the same rules as the backtests (research/jeff_struct.py, checked on Jeff's BTC 5m
//   test case): WEAK follows the wicks; a new high after a pullback moves STRONG (MUST HOLD) up to the lowest low since
//   the last high; a wick past equal highs (within 0.01%) that closes back inside = sweep, STRONG doesn't move;
//   MS = a body close past STRONG's wick, confirmed if the next candle doesn't close back inside. Down legs = mirror.
// LINES: MUST HOLD (STRONG) and the LEG HIGH / LEG LOW (WEAK), solid, labels at the right. They move on every BOS
//   and flip on a market shift. Premium/discount shading = this newest leg (fib 1 = STRONG, 0 = WEAK, 50% in between).
// KEY: one row at the bottom of the box (top right). Not a buy signal by itself.
//@version=6
indicator("Jeff's Smoke Detector v23", shorttitle="Smoke", overlay=true, max_lines_count=40, max_labels_count=300, max_boxes_count=30, max_bars_back=500)

nLen      = input.int(1, "Newest leg: swing size (candles each side)", minval=1, maxval=5, tooltip="1 matched Jeff's BTC 5m test case; 2 or 3 = bigger swings")
swingLen  = input.int(5, "Big swing: swing size (candles each side)", minval=2, maxval=20)
txtSize   = input.string("Large", "Text size (box + labels)", options=["Small", "Normal", "Large", "Huge"])
showLns   = input.bool(true, "Show the MUST HOLD + LEG HIGH/LOW lines")
showBox   = input.bool(true, "Show the box (top right)")
showFib   = input.bool(true, "Show premium / discount shading (newest leg)")
showZones = input.bool(false, "Show the latest supply (premium) and demand (discount) zones")
showFvg   = input.bool(false, "Show the latest imbalances (FVG)")
fvgMax    = input.int(3, "How many imbalances to show", minval=1, maxval=6)
zoneT     = input.int(85, "Zone fill see-through %", minval=0, maxval=100)
zoneW     = input.int(1, "Zone border thickness", minval=1, maxval=5)
showPlan  = input.bool(true, "Show the long/short box when price is in the right zone")
planT     = input.int(85, "Long/short box fill see-through %", minval=0, maxval=100)
planW     = input.int(1, "Long/short box border thickness", minval=1, maxval=5)
slBuf     = input.float(0.15, "Stop cushion past the MUST HOLD level (x ATR)", minval=0, step=0.05)
acct      = input.float(197, "My account size ($)", minval=1)
riskPct   = input.float(0.5, "Risk per trade (% of account)", minval=0.05, maxval=5, step=0.05)
feePct    = input.float(0.35, "Fee per buy or sell (%)", minval=0, step=0.01)
ext1      = input.float(0.27, "TP2 Fib extension (0.27 = the -27% line)", minval=0.05, step=0.01)
fibMode   = input.string("Newest leg (my fib)", "Premium/discount shading follows", options=["Newest leg (my fib)", "Bigger swing (old way)"])
onB       = input.bool(true, "Color: B white (buyers)", group="Candle colors")
onS       = input.bool(true, "Color: S black (sellers)", group="Candle colors")
onBos     = input.bool(true, "Color: BOS green / red", group="Candle colors")
onMs      = input.bool(true, "Color: MS purple", group="Candle colors")
onFo      = input.bool(true, "Color: FO orange (fake-out / sweep)", group="Candle colors")
showPat   = input.bool(false, "Show candle pattern names (only away from the middle)")

tsz = txtSize == "Small" ? size.small : txtSize == "Normal" ? size.normal : txtSize == "Huge" ? size.huge : size.large
cB   = color.white
cS   = color.black
cUp  = color.rgb(0, 230, 118)
cDn  = color.rgb(255, 50, 50)
cMs  = color.rgb(170, 60, 255)
cFo  = color.rgb(255, 140, 0)

atr  = ta.atr(14)
ph   = ta.pivothigh(high, swingLen, swingLen)
pl   = ta.pivotlow(low, swingLen, swingLen)
body = math.abs(close - open)
rng  = high - low

// Squeeze: Bollinger width near its lowest in 100 candles = price coiling sideways (box text only)
basis   = ta.sma(close, 20)
sd20    = ta.stdev(close, 20)
bbw     = basis > 0 ? 4 * sd20 / basis : na
bbwLow  = ta.lowest(bbw, 100)
squeeze = not na(bbw) and not na(bbwLow) and bbw <= bbwLow * 1.10

// ---------- Big swing (old engine, swing size 5): only for the "big swing" text, zones and the old-way shading ----------
var float swH    = na
var float swL    = na
var bool  hDone  = true
var bool  lDone  = true
var int   trend  = 0
var float strong = na
var float ext    = na

var float supTop = na
var float supBot = na
var int   supBar = na
var float demTop = na
var float demBot = na
var int   demBar = na

if not na(ph)
    swH   := ph
    hDone := false
    for i = swingLen to swingLen + 5
        if close[i] > open[i]
            supTop := math.max(high[i], ph)
            supBot := low[i]
            supBar := bar_index - i
            break
if not na(pl)
    swL   := pl
    lDone := false
    for i = swingLen to swingLen + 5
        if close[i] < open[i]
            demTop := high[i]
            demBot := math.min(low[i], pl)
            demBar := bar_index - i
            break
if not na(supTop) and close > supTop
    supTop := na
    supBot := na
if not na(demBot) and close < demBot
    demTop := na
    demBot := na

// Imbalances (FVG): a gap between candle 1 and candle 3. Kept until price fills it.
var array<float> fTop = array.new<float>()
var array<float> fBot = array.new<float>()
var array<int>   fBar = array.new<int>()
var array<int>   fDir = array.new<int>()
if low > high[2] and (low - high[2]) >= 0.1 * atr
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fBar, bar_index - 1)
    array.push(fDir, 1)
if high < low[2] and (low[2] - high) >= 0.1 * atr
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fBar, bar_index - 1)
    array.push(fDir, -1)
if array.size(fTop) > 0
    for i = array.size(fTop) - 1 to 0
        filled = array.get(fDir, i) == 1 ? low <= array.get(fBot, i) : high >= array.get(fTop, i)
        if filled and array.get(fBar, i) < bar_index - 1
            array.remove(fTop, i)
            array.remove(fBot, i)
            array.remove(fBar, i)
            array.remove(fDir, i)
while array.size(fTop) > fvgMax
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fBar)
    array.shift(fDir)

if trend == 1
    ext := math.max(nz(ext, high), high)
    if not na(strong) and close < strong
        trend  := -1
        strong := ext
        ext    := low
        lDone  := true
    else if not hDone and close > swH
        hDone  := true
        strong := na(strong) ? swL : math.max(strong, swL)
    else if not lDone and close < swL
        lDone := true
else if trend == -1
    ext := math.min(nz(ext, low), low)
    if not na(strong) and close > strong
        trend  := 1
        strong := ext
        ext    := high
        hDone  := true
    else if not lDone and close < swL
        lDone  := true
        strong := na(strong) ? swH : math.min(strong, swH)
    else if not hDone and close > swH
        hDone := true
else
    if not hDone and close > swH
        trend  := 1
        hDone  := true
        strong := swL
        ext    := high
    else if not lDone and close < swL
        trend  := -1
        lDone  := true
        strong := swH
        ext    := low

// ---------- Newest leg = Jeff's heartbeat structure (research/jeff_struct.py) ----------
hTol = 0.0001   // equal highs / lows = within 0.01% (Jeff)
lo2N = ta.lowest(low, 2 * nLen + 1)
loN  = ta.lowest(low, nLen)
hi2N = ta.highest(high, 2 * nLen + 1)
hiN  = ta.highest(high, nLen)
isPL = bar_index >= 2 * nLen and low[nLen] == lo2N and low[nLen] < loN
isPH = bar_index >= 2 * nLen and high[nLen] == hi2N and high[nLen] > hiN
var float hpl  = na
var float hph  = na
var int   hplb = -1
var int   hphb = -1
var int   hTr  = 0      // 1 up leg, -1 down leg
var float hS   = na     // STRONG = MUST HOLD (fib 1)
var float hW   = na     // WEAK = leg high (up) / leg low (down) (fib 0)
var int   hSb  = 0
var int   hWb  = 0
var int   hPend = -1    // candle that closed past STRONG, waiting 1 candle
if isPL
    hpl  := low[nLen]
    hplb := bar_index - nLen
if isPH
    hph  := high[nLen]
    hphb := bar_index - nLen

// lowest low / highest high since WEAK, and since the last swing (for a new leg's start)
nW   = math.min(math.max(1, bar_index - hWb + 1), 499)
loW  = ta.lowest(low, nW)
loWb = bar_index + ta.lowestbars(low, nW)
hiW  = ta.highest(high, nW)
hiWb = bar_index + ta.highestbars(high, nW)
nP   = math.min(math.max(1, bar_index - hphb + 1), 499)
loP  = ta.lowest(low, nP)
loPb = bar_index + ta.lowestbars(low, nP)
nQ   = math.min(math.max(1, bar_index - hplb + 1), 499)
hiQ  = ta.highest(high, nQ)
hiQb = bar_index + ta.highestbars(high, nQ)

// another candle between STRONG and now (not WEAK's candle) within 0.01% of lvl = equal highs / lows (a liquidity pool)
f_pool(float lvl, int fromBar, bool useLow) =>
    found = false
    n = math.min(bar_index - fromBar, 400)
    if n >= 1
        for o = 1 to n
            if bar_index - o != hWb
                v = useLow ? low[o] : high[o]
                if math.abs(v - lvl) <= hTol * math.abs(lvl)
                    found := true
                    break
    found

prevS      = hS
prevTr     = hTr
hStart     = 0
hMsPrev    = false   // the last candle was a market shift (confirmed by this candle)
hGrabPrev  = false   // the last candle closed past STRONG, this one closed back inside = fuel grab
hBos       = false
hBosBody   = false
hSweep     = false
float hBosLvl = na
if hTr == 0
    if not na(hph) and close > hph
        hTr := 1
        hS  := loP
        hSb := loPb
        hW  := high
        hWb := bar_index
        hStart := 1
    else if not na(hpl) and close < hpl
        hTr := -1
        hS  := hiQ
        hSb := hiQb
        hW  := low
        hWb := bar_index
        hStart := -1
else
    up = hTr == 1
    if hPend >= 0
        hPend := -1
        if up ? close < hS : close > hS
            oldW  = hW
            oldWb = hWb
            hTr := up ? -1 : 1
            hS  := oldW
            hSb := oldWb
            hW  := up ? low[1] : high[1]
            hWb := bar_index - 1
            hMsPrev := true
            up := not up
        else
            hGrabPrev := true
    if up ? close < hS : close > hS
        hPend := bar_index
    else if up and high > hW
        pulled = hplb >= hWb
        grab   = hplb > hWb and close <= hW and f_pool(hW, hSb, false)
        if pulled and not grab
            hBos     := true
            hBosLvl  := hW
            hBosBody := close > hW
            hS  := loW
            hSb := loWb
        else if grab
            hSweep := true
        hW  := high
        hWb := bar_index
    else if not up and low < hW
        pulled = hphb >= hWb
        grab   = hphb > hWb and close >= hW and f_pool(hW, hSb, true)
        if pulled and not grab
            hBos     := true
            hBosLvl  := hW
            hBosBody := close < hW
            hS  := hiW
            hSb := hiWb
        else if grab
            hSweep := true
        hW  := low
        hWb := bar_index

// a wick past MUST HOLD with the body back inside = sweep of STRONG
strongSweep = prevTr == 1 and not na(prevS) and low < prevS and close >= prevS or prevTr == -1 and not na(prevS) and high > prevS and close <= prevS

// a BOS undone within 3 candles (body closes back through the level it broke) = fake-out
var float fbLvl = na
var int   fbBar = na
var int   fbDir = 0
failedBos = false
if hBos and hBosBody
    fbLvl := hBosLvl
    fbBar := bar_index
    fbDir := hTr
else if not na(fbLvl) and bar_index - fbBar <= 3 and not hMsPrev
    if (fbDir == 1 and close < fbLvl) or (fbDir == -1 and close > fbLvl)
        failedBos := true
        fbLvl := na
if not na(fbBar) and bar_index - fbBar > 3
    fbLvl := na

bosUp = (hBos and hBosBody and hTr == 1) or hStart == 1
bosDn = (hBos and hBosBody and hTr == -1) or hStart == -1
fo    = (hBos and not hBosBody) or hSweep or strongSweep or failedBos

baseCol  = close >= open ? (onB ? cB : na) : (onS ? cS : na)
candleCol = onFo and fo ? cFo : onBos and bosUp ? cUp : onBos and bosDn ? cDn : baseCol
barcolor(candleCol)
// MS / fuel grab are known one candle later: recolor the candle that broke
barcolor(onMs and hMsPrev ? cMs : onFo and hGrabPrev ? cFo : na, offset=-1)

// ---------- Candle pattern names (off by default) ----------
mph = ta.pivothigh(high, 2, 2)
mpl = ta.pivotlow(low, 2, 2)
var float mH = na
var float mL = na
dblBot = false
dblTop = false
if not na(mph)
    dblTop := not na(mH) and math.abs(mph - mH) <= 0.3 * atr
    mH     := mph
if not na(mpl)
    dblBot := not na(mL) and math.abs(mpl - mL) <= 0.3 * atr
    mL     := mpl
hammer   = rng > 0 and body <= 0.35 * rng and math.min(open, close) - low >= 0.6 * rng
shooting = rng > 0 and body <= 0.35 * rng and high - math.max(open, close) >= 0.6 * rng
bullEng  = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
bearEng  = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]
mStar    = open[2] - close[2] > 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * (open[2] - close[2]) and close > open and close > (open[2] + close[2]) / 2
eStar    = close[2] - open[2] > 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * (close[2] - open[2]) and close < open and close < (open[2] + close[2]) / 2
solid(i) => math.abs(close[i] - open[i]) >= 0.5 * (high[i] - low[i])
soldiers = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and solid(0) and solid(1) and solid(2)
crows    = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and solid(0) and solid(1) and solid(2)
bullTxt = (hammer ? "Hammer " : "") + (bullEng ? "Engulfing " : "") + (mStar ? "Morning star " : "") + (soldiers ? "3 soldiers " : "") + (dblBot ? "Double bottom " : "")
bearTxt = (shooting ? "Shooting star " : "") + (bearEng ? "Engulfing " : "") + (eStar ? "Evening star " : "") + (crows ? "3 crows " : "") + (dblTop ? "Double top " : "")

// ---------- Premium / discount of the newest leg ----------
useNew  = fibMode == "Newest leg (my fib)"
zTrend  = useNew ? hTr : trend
zStrong = useNew ? hS : strong
zTop    = hTr == 1 ? hW : hS
zBot    = hTr == 1 ? hS : hW
rangeOk = useNew ? (hTr != 0 and not na(zTop) and not na(zBot) and zTop > zBot) : (trend != 0 and not na(strong) and not na(ext) and strong != ext)
rangeHi = rangeOk ? (useNew ? zTop : math.max(strong, ext)) : na
rangeLo = rangeOk ? (useNew ? zBot : math.min(strong, ext)) : na
mid     = rangeOk ? (rangeHi + rangeLo) / 2 : na
inDiscount = rangeOk and zTrend == 1 and close <= mid and close > zStrong
inPremium  = rangeOk and zTrend == -1 and close >= mid and close < zStrong

pos     = rangeOk ? (close - rangeLo) / (rangeHi - rangeLo) : na
lowPart = na(pos) or pos <= 0.4
topPart = na(pos) or pos >= 0.6
if showPat and lowPart and bullTxt != ""
    label.new(bar_index, low, str.trim(bullTxt), style=label.style_label_up, color=color.rgb(0, 140, 80), textcolor=color.white, size=tsz)
if showPat and topPart and bearTxt != ""
    label.new(bar_index, high, str.trim(bearTxt), style=label.style_label_down, color=color.rgb(170, 40, 40), textcolor=color.white, size=tsz)

// ---------- Long/short idea when price is in the right zone: stop past MUST HOLD, TP1 = the leg end (0%), TP2 = -27% ----------
float pEntry = na
float pSL    = na
float pTP1   = na
float pTP2   = na
int   pDir   = 0
if showPlan and (inDiscount or inPremium)
    pDir   := inDiscount ? 1 : -1
    pEntry := close
    pSL    := pDir == 1 ? zStrong - slBuf * atr : zStrong + slBuf * atr
    hair   = 0.1 * atr
    swingEnd = pDir == 1 ? rangeHi : rangeLo
    fibX = swingEnd + pDir * ext1 * (rangeHi - rangeLo)
    pTP1 := swingEnd - pDir * hair
    pTP2 := fibX - pDir * hair

slPct  = pDir != 0 ? math.abs(pEntry - pSL) / pEntry * 100 : na
tp1Pct = pDir != 0 ? math.abs(pTP1 - pEntry) / pEntry * 100 : na
tp2Pct = pDir != 0 ? math.abs(pTP2 - pEntry) / pEntry * 100 : na
rr1    = pDir != 0 ? math.abs(pTP1 - pEntry) / math.abs(pEntry - pSL) : na
rr2    = pDir != 0 ? math.abs(pTP2 - pEntry) / math.abs(pEntry - pSL) : na
rrTxt(r) => str.tostring(r, "#.#") + ":1"
rrCol(r) => r >= 2 ? color.white : color.gray   // Jeff: at least 2:1; under 2:1 just shows grey

riskUsd = acct * riskPct / 100
fee     = feePct / 100
posUsd  = pDir != 0 ? math.min(riskUsd / (slPct / 100 + 2 * fee), acct) : na
win1    = pDir != 0 ? posUsd * (tp1Pct / 100 - 2 * fee) : na
win2    = pDir != 0 ? posUsd * (tp2Pct / 100 - 2 * fee) : na

// ---------- Drawing (last candle only, everything old is cleared first) ----------
var array<box>   bxs = array.new<box>()
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
clear = color.new(color.black, 100)
gCol  = color.rgb(0, 200, 100)
rCol  = color.rgb(230, 60, 60)
fCol  = color.rgb(90, 150, 255)
if barstate.islast
    for b in bxs
        box.delete(b)
    for ln in lns
        line.delete(ln)
    for lb in lbs
        label.delete(lb)
    array.clear(bxs)
    array.clear(lns)
    array.clear(lbs)
    xL = bar_index - 40
    xR = bar_index + 15
    lvlS = useNew ? hS : strong
    if showLns and not na(lvlS)
        array.push(lns, line.new(bar_index - 1, lvlS, bar_index, lvlS, extend=extend.both, color=color.rgb(235, 235, 235), width=2, style=line.style_solid))
        array.push(lbs, label.new(bar_index + 3, lvlS, "MUST HOLD " + str.tostring(lvlS, format.mintick), style=label.style_label_left, color=color.rgb(70, 70, 70), textcolor=color.white, size=tsz))
    if showLns and useNew and not na(hW)
        legCol = hTr == 1 ? gCol : rCol
        array.push(lns, line.new(bar_index - 1, hW, bar_index, hW, extend=extend.both, color=legCol, width=2, style=line.style_solid))
        array.push(lbs, label.new(bar_index + 3, hW, (hTr == 1 ? "LEG HIGH " : "LEG LOW ") + str.tostring(hW, format.mintick), style=label.style_label_left, color=legCol, textcolor=color.white, size=tsz))
    if showFib and rangeOk
        array.push(bxs, box.new(xL, rangeHi, xR, mid, border_color=clear, bgcolor=color.new(rCol, 92)))
        array.push(lbs, label.new(xL + 2, rangeHi - (rangeHi - mid) * 0.15, "PREMIUM", style=label.style_label_left, color=color.rgb(255, 175, 175), textcolor=color.black, size=tsz))
        array.push(bxs, box.new(xL, mid, xR, rangeLo, border_color=clear, bgcolor=color.new(gCol, 92)))
        array.push(lbs, label.new(xL + 2, rangeLo + (mid - rangeLo) * 0.15, "DISCOUNT", style=label.style_label_left, color=color.rgb(170, 235, 190), textcolor=color.black, size=tsz))
        array.push(lns, line.new(xL, mid, xR, mid, color=color.rgb(200, 200, 200), width=1, style=line.style_dashed))
        array.push(lbs, label.new(xL, mid, "50%  " + str.tostring(mid, format.mintick), style=label.style_label_right, color=color.rgb(200, 200, 200), textcolor=color.black, size=tsz))
    if showZones and rangeOk
        if not na(demTop) and demTop <= mid
            array.push(bxs, box.new(demBar, demTop, xR, demBot, border_color=gCol, border_width=zoneW, border_style=line.style_solid, bgcolor=color.new(gCol, zoneT), text="DEMAND", text_size=size.normal, text_color=color.white, text_halign=text.align_right))
        if not na(supBot) and supBot >= mid
            array.push(bxs, box.new(supBar, supTop, xR, supBot, border_color=rCol, border_width=zoneW, border_style=line.style_solid, bgcolor=color.new(rCol, zoneT), text="SUPPLY", text_size=size.normal, text_color=color.white, text_halign=text.align_right))
    if showFvg and array.size(fTop) > 0
        for i = 0 to array.size(fTop) - 1
            array.push(bxs, box.new(array.get(fBar, i), array.get(fTop, i), xR, array.get(fBot, i), border_color=fCol, border_width=zoneW, border_style=line.style_solid, bgcolor=color.new(fCol, zoneT), text="FVG", text_size=size.normal, text_color=color.white, text_halign=text.align_right))
    if pDir != 0
        x1 = bar_index + 1
        x2 = bar_index + 22
        tip = (pDir == 1 ? "LONG" : "SHORT") + " if you enter now" + "\nEntry: " + str.tostring(pEntry, format.mintick) + "\nStop: " + str.tostring(pSL, format.mintick) + "  (" + str.tostring(slPct, "#.##") + "%)" + "\nTP1 (0% line): " + str.tostring(pTP1, format.mintick) + "  (" + str.tostring(tp1Pct, "#.##") + "%)  R:R " + rrTxt(rr1) + "\nTP2 (-27%): " + str.tostring(pTP2, format.mintick) + "  (" + str.tostring(tp2Pct, "#.##") + "%)  R:R " + rrTxt(rr2) + "\nBuy about $" + str.tostring(posUsd, "#.##") + "  (" + str.tostring(posUsd / pEntry, "#.######") + " coins)" + "\nIf stopped: lose about $" + str.tostring(riskUsd, "#.##") + "\nAt TP1: win about $" + str.tostring(win1, "#.##") + " after fees" + "\nAt TP2: win about $" + str.tostring(win2, "#.##") + " after fees"
        array.push(bxs, box.new(x1, math.max(pEntry, pTP2), x2, math.min(pEntry, pTP2), border_color=gCol, border_width=planW, border_style=line.style_solid, bgcolor=color.new(gCol, planT)))
        array.push(bxs, box.new(x1, math.max(pEntry, pSL), x2, math.min(pEntry, pSL), border_color=rCol, border_width=planW, border_style=line.style_solid, bgcolor=color.new(rCol, planT)))
        array.push(lbs, label.new(x2, pEntry, pDir == 1 ? "LONG" : "SHORT", style=label.style_label_left, color=pDir == 1 ? color.rgb(0, 150, 70) : color.rgb(200, 30, 30), textcolor=color.white, size=tsz, tooltip=tip))
        array.push(lbs, label.new(x2, pSL, "SL " + str.tostring(slPct, "#.##") + "%", style=label.style_label_left, color=rCol, textcolor=color.white, size=tsz, tooltip=tip))
        array.push(lns, line.new(x1, pTP1, x2, pTP1, color=gCol, width=1, style=line.style_dashed))
        array.push(lbs, label.new(x2, pTP1, "TP1 " + rrTxt(rr1), style=label.style_label_left, color=rr1 >= 2 ? gCol : color.gray, textcolor=color.white, size=tsz, tooltip=tip))
        array.push(lbs, label.new(x2, pTP2, "TP2 -27% " + rrTxt(rr2), style=label.style_label_left, color=rr2 >= 2 ? color.rgb(0, 150, 70) : color.gray, textcolor=color.white, size=tsz, tooltip=tip))

// ---------- The box (top right), key row at the bottom ----------
lvl   = str.tostring(zStrong, format.mintick)
hi10 = ta.highest(close, 10)[1]
lo10 = ta.lowest(close, 10)[1]
expanding = zTrend == 1 ? close > hi10 : zTrend == -1 ? close < lo10 : false
phase = hPend == bar_index ? "MS? closed past MUST HOLD " + lvl + ": waiting 1 candle (closes back inside = fake-out)" : squeeze ? "Sideways: squeeze, breakout coming" : expanding ? "Expanding" : zTrend != 0 and not na(zStrong) ? "Pullback, loading orders: holds while " + (zTrend == 1 ? "above " : "below ") + lvl : "Waiting for structure"
who   = (hTr == 1 ? "Newest leg UP: buyers" : hTr == -1 ? "Newest leg DOWN: sellers" : "Newest leg: not known yet") + "   |   big swing: " + (trend == 1 ? "UP" : trend == -1 ? "DOWN" : "none")
var table tb = table.new(position.top_right, 6, 6, bgcolor=color.new(color.black, 15), frame_color=color.gray, frame_width=1, border_width=3)
var bool merged = false
if barstate.islast and showBox
    if not merged
        for r = 0 to 4
            table.merge_cells(tb, 0, r, 5, r)
        merged := true
    table.cell(tb, 0, 0, who, text_color=zTrend == 1 ? cUp : zTrend == -1 ? color.rgb(255, 80, 80) : color.white, text_size=tsz)
    table.cell(tb, 0, 1, phase, text_color=color.white, text_size=tsz)
    if pDir != 0
        planTxt = (pDir == 1 ? "LONG idea (enter now): " : "SHORT idea (enter now): ") + "SL " + str.tostring(pSL, format.mintick) + "   TP1 " + str.tostring(pTP1, format.mintick) + "   TP2 " + str.tostring(pTP2, format.mintick)
        table.cell(tb, 0, 2, planTxt, text_color=pDir == 1 ? cUp : color.rgb(255, 80, 80), text_size=tsz)
        sizeTxt = "Risk $" + str.tostring(riskUsd, "#.##") + " -> buy $" + str.tostring(posUsd, "#.##") + " (" + str.tostring(posUsd / pEntry, "#.######") + " coins). Win at TP1 ~$" + str.tostring(win1, "#.##") + ", at TP2 ~$" + str.tostring(win2, "#.##")
        table.cell(tb, 0, 3, sizeTxt, text_color=color.white, text_size=tsz)
        table.cell(tb, 0, 4, "Reward/risk   TP1 " + rrTxt(rr1) + "   |   TP2 (-27%) " + rrTxt(rr2), text_color=rrCol(math.max(rr1, rr2)), text_size=tsz)
    else
        waitTxt = not rangeOk ? "No trade idea: waiting for structure" : zTrend == 1 ? "No trade now: wait for a pullback into DISCOUNT (below " + str.tostring(mid, format.mintick) + ")" : "No trade now: wait for a bounce into PREMIUM (above " + str.tostring(mid, format.mintick) + ")"
        table.cell(tb, 0, 2, waitTxt, text_color=color.rgb(200, 200, 200), text_size=tsz)
        table.cell(tb, 0, 3, "", text_size=tsz)
        table.cell(tb, 0, 4, "", text_size=tsz)
    table.cell(tb, 0, 5, "BOS▲", bgcolor=cUp, text_color=color.black, text_size=tsz)
    table.cell(tb, 1, 5, "BOS▼", bgcolor=cDn, text_color=color.white, text_size=tsz)
    table.cell(tb, 2, 5, "B", bgcolor=cB, text_color=color.black, text_size=tsz)
    table.cell(tb, 3, 5, "S", bgcolor=cS, text_color=color.white, text_size=tsz)
    table.cell(tb, 4, 5, "MS", bgcolor=cMs, text_color=color.white, text_size=tsz)
    table.cell(tb, 5, 5, "FO", bgcolor=cFo, text_color=color.black, text_size=tsz)

// Phone / app alerts (TradingView: Alert > Condition: Jeff's Smoke Detector)
alertcondition(pDir != 0 and pDir[1] == 0, "Long/short box: price in the right zone", "Smoke Detector: price is in the right zone of the newest leg")
alertcondition(hMsPrev, "PURPLE: market shift (confirmed)", "Market shift: a body closed past MUST HOLD and the next candle held")
alertcondition(fo or hGrabPrev, "ORANGE: fake-out / sweep", "Fake-out: a wick swept a level and the body closed back inside, or a break was undone")
alertcondition(bosUp or bosDn, "BOS", "Break of structure: a body closed past the newest leg's high/low")
