//@version=5
// AMD + FVG — Accumulation box, Manipulation sweep, Fair Value Gap, Distribution signal.
// Shows ATR-based stop and target. For viewing only. It does not place trades.
indicator("AMD + FVG Setup", overlay=true, max_boxes_count=300, max_lines_count=300, max_labels_count=300)

accLen    = input.int(30, "Accumulation length (bars)", minval=5)
rangeMode = input.string("ATR", "Measure range by", options=["ATR", "Percent"])
rangeATR  = input.float(3.5, "Max box height (x ATR)", step=0.1)
rangePct  = input.float(0.2, "Max box height (% of price)", step=0.05)
window    = input.int(10, "Search window after box (bars)", minval=1)
minGap    = input.float(0.0, "Min FVG size (x ATR)", step=0.05)
slATR     = input.float(1.5, "Stop distance (x ATR)", step=0.1)
rr        = input.float(2.0, "Reward : risk", step=0.5)
showLong  = input.bool(true, "Show long setups")
showShort = input.bool(true, "Show short setups")
useSess   = input.bool(false, "Only signal inside session")
sess      = input.session("0930-1600", "Session")
tz        = input.string("America/New_York", "Session time zone")
onlyFull  = input.bool(true, "Only show complete setups (in order)")

atr = ta.atr(14)
hh  = ta.highest(high, accLen)
ll  = ta.lowest(low, accLen)
tight = rangeMode == "ATR" ? (hh - ll) <= rangeATR * atr : (hh - ll) <= rangePct / 100 * close
inSess = not useSess or not na(time(timeframe.period, sess, tz))

var int   state = 0
var float top = na
var float bot = na
var int   boxEnd = na
var bool  sweptDn = false
var bool  sweptUp = false
var int   mDnBar = na
var float mDnPx = na
var int   mUpBar = na
var float mUpPx = na

longSig  = false
shortSig = false

if barstate.isconfirmed
    if state == 0 and tight
        state := 1
        top := hh
        bot := ll
        boxEnd := bar_index
        sweptDn := false
        sweptUp := false
        if not onlyFull
            box.new(bar_index - accLen + 1, top, bar_index, bot, border_color=color.new(color.gray, 30), bgcolor=color.new(color.gray, 85), text="Accumulation", text_color=color.gray, text_size=size.tiny, text_valign=text.align_top)
    else if state == 1
        if bar_index - boxEnd > window
            state := 0
        else
            mid = (top + bot) / 2
            if low < bot and not sweptDn
                sweptDn := true
                mDnBar := bar_index
                mDnPx := low
                if not onlyFull
                    label.new(bar_index, low, "M", style=label.style_label_up, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)
            if high > top and not sweptUp
                sweptUp := true
                mUpBar := bar_index
                mUpPx := high
                if not onlyFull
                    label.new(bar_index, high, "M", style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)
            bullFvg = low > high[2] and (low - high[2]) >= minGap * atr
            bearFvg = high < low[2] and (low[2] - high) >= minGap * atr
            if sweptDn and bullFvg and close > bot and inSess and showLong
                longSig := true
                if onlyFull
                    box.new(boxEnd - accLen + 1, top, boxEnd, bot, border_color=color.new(color.gray, 30), bgcolor=color.new(color.gray, 85), text="Accumulation", text_color=color.gray, text_size=size.tiny, text_valign=text.align_top)
                    label.new(mDnBar, mDnPx, "M", style=label.style_label_up, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)
                box.new(bar_index - 2, low, bar_index + 5, high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80), text="FVG", text_color=color.green, text_size=size.tiny)
                state := 0
            else if sweptUp and bearFvg and close < top and inSess and showShort
                shortSig := true
                if onlyFull
                    box.new(boxEnd - accLen + 1, top, boxEnd, bot, border_color=color.new(color.gray, 30), bgcolor=color.new(color.gray, 85), text="Accumulation", text_color=color.gray, text_size=size.tiny, text_valign=text.align_top)
                    label.new(mUpBar, mUpPx, "M", style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)
                box.new(bar_index - 2, low[2], bar_index + 5, high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 80), text="FVG", text_color=color.red, text_size=size.tiny)
                state := 0

if longSig
    risk = slATR * atr
    sl = close - risk
    tp = close + rr * risk
    line.new(bar_index, sl, bar_index + 15, sl, color=color.red, width=2)
    line.new(bar_index, tp, bar_index + 15, tp, color=color.green, width=2)
    line.new(bar_index, close, bar_index + 15, close, color=color.blue)
    label.new(bar_index, low, "BUY — FVG signal\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick), style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if shortSig
    risk = slATR * atr
    sl = close + risk
    tp = close - rr * risk
    line.new(bar_index, sl, bar_index + 15, sl, color=color.red, width=2)
    line.new(bar_index, tp, bar_index + 15, tp, color=color.green, width=2)
    line.new(bar_index, close, bar_index + 15, close, color=color.blue)
    label.new(bar_index, high, "SELL — FVG signal\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

bgcolor(useSess and inSess ? color.new(color.blue, 94) : na, title="Session")
alertcondition(longSig, "AMD long", "AMD + FVG long setup on {{ticker}}")
alertcondition(shortSig, "AMD short", "AMD + FVG short setup on {{ticker}}")
